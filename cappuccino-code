\n","if not CONFIG_PATH.exists():\n","    raise FileNotFoundError(\n","        \"config.json not found. Please run Stage 00 first.\"\n","    )\n","\n","with open(CONFIG_PATH, \"r\", encoding=\"utf-8\") as f:\n","    CONFIG = json.load(f)\n","\n","\n","DATASET_PATH = Path(CONFIG[\"dataset_path\"])\n","\n","\n","# ------------------------------------------------------------\n","# 2. Canonical dataset roots\n","# ------------------------------------------------------------\n","\n","IMAGE_ROOT = DATASET_PATH / \"Images\" / \"Images\"\n","\n","FACS_ROOT = (\n","    DATASET_PATH\n","    / \"Frame_Labels\"\n","    / \"Frame_Labels\"\n","    / \"FACS\"\n",")\n","\n","PSPI_ROOT = (\n","    DATASET_PATH\n","    / \"Frame_Labels\"\n","    / \"Frame_Labels\"\n","    / \"PSPI\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 3. Validate roots\n","# ------------------------------------------------------------\n","\n","for name, path in {\n","    \"IMAGE_ROOT\": IMAGE_ROOT,\n","    \"FACS_ROOT\": FACS_ROOT,\n","    \"PSPI_ROOT\": PSPI_ROOT,\n","}.items():\n","\n","    if not path.exists():\n","        raise FileNotFoundError(\n","            f\"{name} does not exist:\\n{path}\"\n","        )\n","\n","\n","print(\"=\" * 70)\n","print(\"CAPSTONE — STAGE 04\")\n","print(\"Canonical Metadata Construction\")\n","print(\"=\" * 70)\n","\n","print(\"\\nCanonical roots:\")\n","print(f\"Images : {IMAGE_ROOT}\")\n","print(f\"FACS   : {FACS_ROOT}\")\n","print(f\"PSPI   : {PSPI_ROOT}\")\n","\n","\n","# ------------------------------------------------------------\n","# 4. Find canonical images\n","# ------------------------------------------------------------\n","\n","image_files = sorted(IMAGE_ROOT.rglob(\"*.png\"))\n","\n","print(f\"\\nCanonical images found: {len(image_files):,}\")\n","\n","if len(image_files) == 0:\n","    raise RuntimeError(\"No canonical PNG images found.\")\n","\n","\n","# ------------------------------------------------------------\n","# 5. FACS parser\n","# ------------------------------------------------------------\n","\n","def parse_facs_file(path):\n","    \"\"\"\n","    Parse a FACS annotation file.\n","\n","    Expected format per line:\n","\n","        AU_number   intensity   ...\n","\n","    Example:\n","\n","        6.0   2.0   0.0   0.0\n","        12.0  2.0   0.0   0.0\n","\n","    The first two numeric values are interpreted as:\n","        AU identifier\n","        AU intensity\n","\n","    Empty files represent no active FACS annotations.\n","    \"\"\"\n","\n","    active_aus = {}\n","\n","    with open(\n","        path,\n","        \"r\",\n","        encoding=\"utf-8\",\n","        errors=\"replace\"\n","    ) as f:\n","\n","        for line in f:\n","\n","            line = line.strip()\n","\n","            if not line:\n","                continue\n","\n","            values = line.split()\n","\n","            if len(values) < 2:\n","                continue\n","\n","            try:\n","                au_number = int(float(values[0]))\n","                intensity = float(values[1])\n","\n","            except ValueError:\n","                continue\n","\n","            active_aus[au_number] = intensity\n","\n","    return active_aus\n","\n","\n","# ------------------------------------------------------------\n","# 6. PSPI parser\n","# ------------------------------------------------------------\n","\n","def parse_pspi_file(path):\n","    \"\"\"\n","    Parse a PSPI annotation file.\n","\n","    The canonical files contain a single scalar value.\n","    \"\"\"\n","\n","    with open(\n","        path,\n","        \"r\",\n","        encoding=\"utf-8\",\n","        errors=\"replace\"\n","    ) as f:\n","\n","        content = f.read().strip()\n","\n","    if not content:\n","        return np.nan\n","\n","    values = content.split()\n","\n","    try:\n","        return float(values[0])\n","\n","    except (ValueError, IndexError):\n","        return np.nan\n","\n","\n","# ------------------------------------------------------------\n","# 7. Extract identifiers\n","# ------------------------------------------------------------\n","\n","def extract_identifiers(image_path):\n","    \"\"\"\n","    Extract dataset identifiers from the canonical image path.\n","\n","    Example:\n","\n","        052-dr052/dr052t1afaff/dr052t1afaff044.png\n","\n","    produces:\n","\n","        subject_group = 052-dr052\n","        sequence_id   = dr052t1afaff\n","        frame_id      = dr052t1afaff044\n","        frame_number  = 44\n","    \"\"\"\n","\n","    relative = image_path.relative_to(IMAGE_ROOT)\n","\n","    parts = relative.parts\n","\n","    if len(parts) < 3:\n","        raise ValueError(\n","            f\"Unexpected image path structure: {relative}\"\n","        )\n","\n","    subject_group = parts[0]\n","    sequence_id = parts[1]\n","\n","    frame_id = image_path.stem\n","\n","    # Extract trailing frame number.\n","    match = re.search(r\"(\\d+)$\", frame_id)\n","\n","    if match:\n","        frame_number = int(match.group(1))\n","    else:\n","        frame_number = np.nan\n","\n","    return (\n","        subject_group,\n","        sequence_id,\n","        frame_id,\n","        frame_number,\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 8. Determine output path\n","# ------------------------------------------------------------\n","\n","metadata_path = (\n","    Path(\"/kaggle/working/capstone/metadata\")\n","    / \"canonical_metadata.csv\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 9. Reuse existing metadata if valid\n","# ------------------------------------------------------------\n","\n","if metadata_path.exists():\n","\n","    print(\"\\nExisting canonical metadata found.\")\n","    print(f\"Loading: {metadata_path}\")\n","\n","    metadata_df = pd.read_csv(metadata_path)\n","\n","    print(\n","        f\"Loaded {len(metadata_df):,} metadata rows.\"\n","    )\n","\n","else:\n","\n","    print(\n","        \"\\nNo existing metadata found.\"\n","        \"\\nParsing annotation files...\"\n","    )\n","\n","    records = []\n","\n","    # --------------------------------------------------------\n","    # Parse all canonical frames\n","    # --------------------------------------------------------\n","\n","    for i, image_path in enumerate(image_files, start=1):\n","\n","        relative_image = image_path.relative_to(IMAGE_ROOT)\n","\n","        (\n","            subject_group,\n","            sequence_id,\n","            frame_id,\n","            frame_number,\n","        ) = extract_identifiers(image_path)\n","\n","        facs_path = (\n","            FACS_ROOT\n","            / relative_image.parent\n","            / f\"{frame_id}_facs.txt\"\n","        )\n","\n","        pspi_path = (\n","            PSPI_ROOT\n","            / relative_image.parent\n","            / f\"{frame_id}_facs.txt\"\n","        )\n","\n","        if not facs_path.exists():\n","            raise FileNotFoundError(\n","                f\"Missing FACS file:\\n{facs_path}\"\n","            )\n","\n","        if not pspi_path.exists():\n","            raise FileNotFoundError(\n","                f\"Missing PSPI file:\\n{pspi_path}\"\n","            )\n","\n","        # Parse annotations\n","        active_aus = parse_facs_file(facs_path)\n","        pspi = parse_pspi_file(pspi_path)\n","\n","        # ----------------------------------------------------\n","        # Create AU representation\n","        # ----------------------------------------------------\n","\n","        # Store AU numbers and intensities as compact JSON.\n","        au_json = json.dumps(\n","            active_aus,\n","            separators=(\",\", \":\")\n","        )\n","\n","        # Number of active AUs\n","        num_active_aus = len(active_aus)\n","\n","        # Maximum AU intensity\n","        max_au_intensity = (\n","            max(active_aus.values())\n","            if active_aus\n","            else 0.0\n","        )\n","\n","        # ----------------------------------------------------\n","        # Record\n","        # ----------------------------------------------------\n","\n","        records.append({\n","            \"frame_id\": frame_id,\n","            \"subject_group\": subject_group,\n","            \"sequence_id\": sequence_id,\n","            \"frame_number\": frame_number,\n","\n","            \"image_path\": str(image_path),\n","            \"facs_path\": str(facs_path),\n","            \"pspi_path\": str(pspi_path),\n","\n","            \"pspi\": pspi,\n","\n","            \"num_active_aus\": num_active_aus,\n","            \"max_au_intensity\": max_au_intensity,\n","\n","            \"active_aus\": au_json,\n","        })\n","\n","        # Progress\n","        if i % 5000 == 0 or i == len(image_files):\n","\n","            print(\n","                f\"Processed {i:,} / \"\n","                f\"{len(image_files):,} frames\"\n","            )\n","\n","    # --------------------------------------------------------\n","    # Convert to DataFrame\n","    # --------------------------------------------------------\n","\n","    metadata_df = pd.DataFrame(records)\n","\n","    # --------------------------------------------------------\n","    # Basic type normalization\n","    # --------------------------------------------------------\n","\n","    metadata_df[\"frame_number\"] = pd.to_numeric(\n","        metadata_df[\"frame_number\"],\n","        errors=\"coerce\"\n","    )\n","\n","    metadata_df[\"pspi\"] = pd.to_numeric(\n","        metadata_df[\"pspi\"],\n","        errors=\"coerce\"\n","    )\n","\n","    metadata_df[\"num_active_aus\"] = pd.to_numeric(\n","        metadata_df[\"num_active_aus\"],\n","        errors=\"coerce\"\n","    ).fillna(0).astype(int)\n","\n","    metadata_df[\"max_au_intensity\"] = pd.to_numeric(\n","        metadata_df[\"max_au_intensity\"],\n","        errors=\"coerce\"\n","    ).fillna(0.0)\n","\n","    # --------------------------------------------------------\n","    # Save\n","    # --------------------------------------------------------\n","\n","    metadata_df.to_csv(\n","        metadata_path,\n","        index=False\n","    )\n","\n","    print(\"\\nMetadata successfully created.\")\n","\n","\n","# ------------------------------------------------------------\n","# 10. Validate metadata\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"METADATA VALIDATION\")\n","print(\"=\" * 70)\n","\n","print(f\"\\nRows                 : {len(metadata_df):,}\")\n","print(f\"Columns              : {len(metadata_df.columns)}\")\n","\n","print(\"\\nColumns:\")\n","for column in metadata_df.columns:\n","    print(f\"  - {column}\")\n","\n","\n","# ------------------------------------------------------------\n","# 11. Duplicate frame check\n","# ------------------------------------------------------------\n","\n","duplicate_frames = metadata_df[\"frame_id\"].duplicated().sum()\n","\n","print(\n","    f\"\\nDuplicate frame IDs   : \"\n","    f\"{duplicate_frames:,}\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 12. Missing-value check\n","# ------------------------------------------------------------\n","\n","print(\"\\nMissing values:\")\n","print(\"-\" * 40)\n","\n","missing = metadata_df.isna().sum()\n","\n","for column, count in missing.items():\n","\n","    if count > 0:\n","        print(f\"{column:25s}: {count:,}\")\n","\n","\n","# ------------------------------------------------------------\n","# 13. PSPI statistics\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"PSPI DISTRIBUTION\")\n","print(\"=\" * 70)\n","\n","print(\n","    metadata_df[\"pspi\"].describe()\n",")\n","\n","\n","# ---------------------------------------------------------