,"\n","if not CONFIG_PATH.exists():\n","    raise FileNotFoundError(\n","        \"config.json not found. Please run Stage 00 first.\"\n","    )\n","\n","with open(CONFIG_PATH, \"r\", encoding=\"utf-8\") as f:\n","    CONFIG = json.load(f)\n","\n","\n","DATASET_PATH = Path(CONFIG[\"dataset_path\"])\n","\n","\n","# ------------------------------------------------------------\n","# 2. Canonical dataset roots\n","# ------------------------------------------------------------\n","\n","IMAGE_ROOT = DATASET_PATH / \"Images\" / \"Images\"\n","\n","FACS_ROOT = (\n","    DATASET_PATH\n","    / \"Frame_Labels\"\n","    / \"Frame_Labels\"\n","    / \"FACS\"\n",")\n","\n","PSPI_ROOT = (\n","    DATASET_PATH\n","    / \"Frame_Labels\"\n","    / \"Frame_Labels\"\n","    / \"PSPI\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 3. Validate roots\n","# ------------------------------------------------------------\n","\n","for name, path in {\n","    \"IMAGE_ROOT\": IMAGE_ROOT,\n","    \"FACS_ROOT\": FACS_ROOT,\n","    \"PSPI_ROOT\": PSPI_ROOT,\n","}.items():\n","\n","    if not path.exists():\n","        raise FileNotFoundError(\n","            f\"{name} does not exist:\\n{path}\"\n","        )\n","\n","\n","print(\"=\" * 70)\n","print(\"CAPSTONE — STAGE 04\")\n","print(\"Canonical Metadata Construction\")\n","print(\"=\" * 70)\n","\n","print(\"\\nCanonical roots:\")\n","print(f\"Images : {IMAGE_ROOT}\")\n","print(f\"FACS   : {FACS_ROOT}\")\n","print(f\"PSPI   : {PSPI_ROOT}\")\n","\n","\n","# ------------------------------------------------------------\n","# 4. Find canonical images\n","# ------------------------------------------------------------\n","\n","image_files = sorted(IMAGE_ROOT.rglob(\"*.png\"))\n","\n","print(f\"\\nCanonical images found: {len(image_files):,}\")\n","\n","if len(image_files) == 0:\n","    raise RuntimeError(\"No canonical PNG images found.\")\n","\n","\n","# ------------------------------------------------------------\n","# 5. FACS parser\n","# ------------------------------------------------------------\n","\n","def parse_facs_file(path):\n","    \"\"\"\n","    Parse a FACS annotation file.\n","\n","    Expected format per line:\n","\n","        AU_number   intensity   ...\n","\n","    Example:\n","\n","        6.0   2.0   0.0   0.0\n","        12.0  2.0   0.0   0.0\n","\n","    The first two numeric values are interpreted as:\n","        AU identifier\n","        AU intensity\n","\n","    Empty files represent no active FACS annotations.\n","    \"\"\"\n","\n","    active_aus = {}\n","\n","    with open(\n","        path,\n","        \"r\",\n","        encoding=\"utf-8\",\n","        errors=\"replace\"\n","    ) as f:\n","\n","        for line in f:\n","\n","            line = line.strip()\n","\n","            if not line:\n","                continue\n","\n","            values = line.split()\n","\n","            if len(values) < 2:\n","                continue\n","\n","            try:\n","                au_number = int(float(values[0]))\n","                intensity = float(values[1])\n","\n","            except ValueError:\n","                continue\n","\n","            active_aus[au_number] = intensity\n","\n","    return active_aus\n","\n","\n","# ------------------------------------------------------------\n","# 6. PSPI parser\n","# ------------------------------------------------------------\n","\n","def parse_pspi_file(path):\n","    \"\"\"\n","    Parse a PSPI annotation file.\n","\n","    The canonical files contain a single scalar value.\n","    \"\"\"\n","\n","    with open(\n","        path,\n","        \"r\",\n","        encoding=\"utf-8\",\n","        errors=\"replace\"\n","    ) as f:\n","\n","        content = f.read().strip()\n","\n","    if not content:\n","        return np.nan\n","\n","    values = content.split()\n","\n","    try:\n","        return float(values[0])\n","\n","    except (ValueError, IndexError):\n","        return np.nan\n","\n","\n","# ------------------------------------------------------------\n","# 7. Extract identifiers\n","# ------------------------------------------------------------\n","\n","def extract_identifiers(image_path):\n","    \"\"\"\n","    Extract dataset identifiers from the canonical image path.\n","\n","    Example:\n","\n","        052-dr052/dr052t1afaff/dr052t1afaff044.png\n","\n","    produces:\n","\n","        subject_group = 052-dr052\n","        sequence_id   = dr052t1afaff\n","        frame_id      = dr052t1afaff044\n","        frame_number  = 44\n","    \"\"\"\n","\n","    relative = image_path.relative_to(IMAGE_ROOT)\n","\n","    parts = relative.parts\n","\n","    if len(parts) < 3:\n","        raise ValueError(\n","            f\"Unexpected image path structure: {relative}\"\n","        )\n","\n","    subject_group = parts[0]\n","    sequence_id = parts[1]\n","\n","    frame_id = image_path.stem\n","\n","    # Extract trailing frame number.\n","    match = re.search(r\"(\\d+)$\", frame_id)\n","\n","    if match:\n","        frame_number = int(match.group(1))\n","    else:\n","        frame_number = np.nan\n","\n","    return (\n","        subject_group,\n","        sequence_id,\n","        frame_id,\n","        frame_number,\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 8. Determine output path\n","# ------------------------------------------------------------\n","\n","metadata_path = (\n","    Path(\"/kaggle/working/capstone/metadata\")\n","    / \"canonical_metadata.csv\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 9. Reuse existing metadata if valid\n","# ------------------------------------------------------------\n","\n","if metadata_path.exists():\n","\n","    print(\"\\nExisting canonical metadata found.\")\n","    print(f\"Loading: {metadata_path}\")\n","\n","    metadata_df = pd.read_csv(metadata_path)\n","\n","    print(\n","        f\"Loaded {len(metadata_df):,} metadata rows.\"\n","    )\n","\n","else:\n","\n","    print(\n","        \"\\nNo existing metadata found.\"\n","        \"\\nParsing annotation files...\"\n","    )\n","\n","    records = []\n","\n","    # --------------------------------------------------------\n","    # Parse all canonical frames\n","    # --------------------------------------------------------\n","\n","    for i, image_path in enumerate(image_files, start=1):\n","\n","        relative_image = image_path.relative_to(IMAGE_ROOT)\n","\n","        (\n","            subject_group,\n","            sequence_id,\n","            frame_id,\n","            frame_number,\n","        ) = extract_identifiers(image_path)\n","\n","        facs_path = (\n","            FACS_ROOT\n","            / relative_image.parent\n","            / f\"{frame_id}_facs.txt\"\n","        )\n","\n","        pspi_path = (\n","            PSPI_ROOT\n","            / relative_image.parent\n","            / f\"{frame_id}_facs.txt\"\n","        )\n","\n","        if not facs_path.exists():\n","            raise FileNotFoundError(\n","                f\"Missing FACS file:\\n{facs_path}\"\n","            )\n","\n","        if not pspi_path.exists():\n","            raise FileNotFoundError(\n","                f\"Missing PSPI file:\\n{pspi_path}\"\n","            )\n","\n","        # Parse annotations\n","        active_aus = parse_facs_file(facs_path)\n","        pspi = parse_pspi_file(pspi_path)\n","\n","        # ----------------------------------------------------\n","        # Create AU representation\n","        # ----------------------------------------------------\n","\n","        # Store AU numbers and intensities as compact JSON.\n","        au_json = json.dumps(\n","            active_aus,\n","            separators=(\",\", \":\")\n","        )\n","\n","        # Number of active AUs\n","        num_active_aus = len(active_aus)\n","\n","        # Maximum AU intensity\n","        max_au_intensity = (\n","            max(active_aus.values())\n","            if active_aus\n","            else 0.0\n","        )\n","\n","        # ----------------------------------------------------\n","        # Record\n","        # ----------------------------------------------------\n","\n","        records.append({\n","            \"frame_id\": frame_id,\n","            \"subject_group\": subject_group,\n","            \"sequence_id\": sequence_id,\n","            \"frame_number\": frame_number,\n","\n","            \"image_path\": str(image_path),\n","            \"facs_path\": str(facs_path),\n","            \"pspi_path\": str(pspi_path),\n","\n","            \"pspi\": pspi,\n","\n","            \"num_active_aus\": num_active_aus,\n","            \"max_au_intensity\": max_au_intensity,\n","\n","            \"active_aus\": au_json,\n","        })\n","\n","        # Progress\n","        if i % 5000 == 0 or i == len(image_files):\n","\n","            print(\n","                f\"Processed {i:,} / \"\n","                f\"{len(image_files):,} frames\"\n","            )\n","\n","    # --------------------------------------------------------\n","    # Convert to DataFrame\n","    # --------------------------------------------------------\n","\n","    metadata_df = pd.DataFrame(records)\n","\n","    # --------------------------------------------------------\n","    # Basic type normalization\n","    # --------------------------------------------------------\n","\n","    metadata_df[\"frame_number\"] = pd.to_numeric(\n","        metadata_df[\"frame_number\"],\n","        errors=\"coerce\"\n","    )\n","\n","    metadata_df[\"pspi\"] = pd.to_numeric(\n","        metadata_df[\"pspi\"],\n","        errors=\"coerce\"\n","    )\n","\n","    metadata_df[\"num_active_aus\"] = pd.to_numeric(\n","        metadata_df[\"num_active_aus\"],\n","        errors=\"coerce\"\n","    ).fillna(0).astype(int)\n","\n","    metadata_df[\"max_au_intensity\"] = pd.to_numeric(\n","        metadata_df[\"max_au_intensity\"],\n","        errors=\"coerce\"\n","    ).fillna(0.0)\n","\n","    # --------------------------------------------------------\n","    # Save\n","    # --------------------------------------------------------\n","\n","    metadata_df.to_csv(\n","        metadata_path,\n","        index=False\n","    )\n","\n","    print(\"\\nMetadata successfully created.\")\n","\n","\n","# ------------------------------------------------------------\n","# 10. Validate metadata\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"METADATA VALIDATION\")\n","print(\"=\" * 70)\n","\n","print(f\"\\nRows                 : {len(metadata_df):,}\")\n","print(f\"Columns              : {len(metadata_df.columns)}\")\n","\n","print(\"\\nColumns:\")\n","for column in metadata_df.columns:\n","    print(f\"  - {column}\")\n","\n","\n","# ------------------------------------------------------------\n","# 11. Duplicate frame check\n","# ------------------------------------------------------------\n","\n","duplicate_frames = metadata_df[\"frame_id\"].duplicated().sum()\n","\n","print(\n","    f\"\\nDuplicate frame IDs   : \"\n","    f\"{duplicate_frames:,}\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 12. Missing-value check\n","# ------------------------------------------------------------\n","\n","print(\"\\nMissing values:\")\n","print(\"-\" * 40)\n","\n","missing = metadata_df.isna().sum()\n","\n","for column, count in missing.items():\n","\n","    if count > 0:\n","        print(f\"{column:25s}: {count:,}\")\n","\n","\n","# ------------------------------------------------------------\n","# 13. PSPI statistics\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"PSPI DISTRIBUTION\")\n","print(\"=\" * 70)\n","\n","print(\n","    metadata_df[\"pspi\"].describe()\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 14. PSPI frequency\n","# ------------------------------------------------------------\n","\n","print(\"\\nPSPI value counts:\")\n","\n","pspi_counts = (\n","    metadata_df[\"pspi\"]\n","    .value_counts(dropna=False)\n","    .sort_index()\n",")\n","\n","print(pspi_counts.to_string())\n","\n","\n","# ------------------------------------------------------------\n","# 15. Subject/group statistics\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"SUBJECT/GROUP STATISTICS\")\n","print(\"=\" * 70)\n","\n","subject_counts = (\n","    metadata_df[\"subject_group\"]\n","    .value_counts()\n","    .sort_index()\n",")\n","\n","print(\n","    f\"\\nUnique subject groups: \"\n","    f\"{subject_counts.size:,}\"\n",")\n","\n","print(\"\\nFirst 30 groups:\")\n","\n","print(\n","    subject_counts.head(30).to_string()\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 16. Sequence statistics\n","# ------------------------------------------------------------\n","\n","sequence_counts = (\n","    metadata_df[\"sequence_id\"]\n","    .nunique()\n",")\n","\n","print(\n","    f\"\\nUnique sequences: \"\n","    f\"{sequence_counts:,}\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 17. FACS statistics\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"FACS STATISTICS\")\n","print(\"=\" * 70)\n","\n","print(\n","    f\"\\nFrames with ≥1 active AU : \"\n","    f\"{(metadata_df['num_active_aus'] > 0).sum():,}\"\n",")\n","\n","print(\n","    f\"Frames with no active AU  : \"\n","    f\"{(metadata_df['num_active_aus'] == 0).sum():,}\"\n",")\n","\n","print(\n","    f\"Maximum active AUs/frame  : \"\n","    f\"{metadata_df['num_active_aus'].max()}\"\n",")\n","\n","print(\n","    f\"Maximum AU intensity       : \"\n","    f\"{metadata_df['max_au_intensity'].max()}\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 18. Display samples\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"METADATA SAMPLE\")\n","print(\"=\" * 70)\n","\n","display_columns = [\n","    \"frame_id\",\n","    \"subject_group\",\n","    \"sequence_id\",\n","    \"frame_number\",\n","    \"pspi\",\n","    \"num_active_aus\",\n","    \"max_au_intensity\",\n","    \"active_aus\",\n","]\n","\n","print(\n","    metadata_df[display_columns]\n","    .head(15)\n","    .to_string(index=False)\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 19. Save summary\n","# ------------------------------------------------------------\n","\n","summary = {\n","    \"num_frames\": int(len(metadata_df)),\n","    \"num_subject_groups\": int(\n","        metadata_df[\"subject_group\"].nunique()\n","    ),\n","    \"num_sequences\": int(\n","        metadata_df[\"sequence_id\"].nunique()\n","    ),\n","    \"num_duplicate_frame_ids\": int(\n","        duplicate_frames\n","    ),\n","    \"num_missing_pspi\": int(\n","        metadata_df[\"pspi\"].isna().sum()\n","    ),\n","    \"num_frames_with_active_au\": int(\n","        (metadata_df[\"num_active_aus\"] > 0).sum()\n","    ),\n","    \"num_frames_without_active_au\": int(\n","        (metadata_df[\"num_active_aus\"] == 0).sum()\n","    ),\n","    \"pspi_min\": float(\n","        metadata_df[\"pspi\"].min()\n","    ),\n","    \"pspi_max\": float(\n","        metadata_df[\"pspi\"].max()\n","    ),\n","    \"pspi_mean\": float(\n","        metadata_df[\"pspi\"].mean()\n","    ),\n","    \"pspi_median\": float(\n","        metadata_df[\"pspi\"].median()\n","    ),\n","}\n","\n","\n","SUMMARY_PATH = (\n","    Path(\"/kaggle/working/capstone/metadata\")\n","    / \"metadata_summary.json\"\n",")\n","\n","with open(SUMMARY_PATH, \"w\", encoding=\"utf-8\") as f:\n","    json.dump(summary, f, indent=4)\n","\n","\n","# ------------------------------------------------------------\n","# 20. Update configuration\n","# ------------------------------------------------------------\n","\n","CONFIG[\"canonical_metadata\"] = str(metadata_path)\n","\n","with open(CONFIG_PATH, \"w\", encoding=\"utf-8\") as f:\n","    json.dump(CONFIG, f, indent=4)\n","\n","\n","# ------------------------------------------------------------\n","# 21. Final status\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"STAGE 04 COMPLETED SUCCESSFULLY\")\n","print(\"=\" * 70)\n","\n","print(f\"\\nCanonical metadata:\")\n","print(metadata_path)\n","\n","print(f\"\\nMetadata summary:\")\n","print(SUMMARY_PATH)\n","\n","print(\n","    \"\\nThis artifact can be reused after a runtime restart.\"\n",")"]},{"cell_type":"markdown","id":"5396ed50","metadata":{"papermill":{"duration":0.00707,"end_time":"2026-08-27T18:26:30.573465+00:00","exception":false,"start_time":"2026-08-27T18:26:30.566395+00:00","status":"completed"},"tags":[]},"source":["# Stage 04 — Canonical Metadata Construction\n","\n","The canonical dataset contains 48,398 unique facial image frames with corresponding FACS and PSPI annotations.\n","\n","For each frame, this stage constructs a unified metadata record containing:\n","\n","- frame identifier\n","- subject/group identifier\n","- sequence identifier\n","- frame number\n","- image path\n","- FACS annotation path\n","- PSPI annotation path\n","- frame-level PSPI score\n","- number of active action units\n","- maximum AU intensity\n","- complete active-AU representation\n","\n","The metadata is stored as:\n","\n","`/kaggle/working/capstone/metadata/canonical_metadata.csv`\n","\n","This file is treated as a persistent intermediate artifact and is reused on subsequent executions rather than reparsing the original annotation files."]},{"cell_type":"markdown","id":"55c5cf2c","metadata":{"papermill":{"duration":0.006976,"end_time":"2026-08-27T18:26:30.587537+00:00","exception":false,"start_time":"2026-08-27T18:26:30.580561+00:00","status":"completed"},"tags":[]},"source":["# Stage 05 — Subject-Wise Dataset Split\n","\n","To prevent subject leakage, train, validation, and test sets are separated at the subject/group level rather than at the individual frame level.\n","\n","Target allocation:\n","\n","- 70% subject groups: training\n","- 15% subject groups: validation\n","- 15% subject groups: testing\n","\n","A deterministic random seed of 42 is used so that the split remains reproducible.\n","\n","The resulting frame-level split files are stored in:\n","\n","- `/kaggle/working/capstone/splits/train.csv`\n","- `/kaggle/working/capstone/splits/val.csv`\n","- `/kaggle/working/capstone/splits/test.csv`\n","\n","The split summary and subject assignments are stored in:\n","\n","`/kaggle/working/capstone/splits/split_summary.json`\n","\n","No subject or frame is allowed to occur in more than one partition."]},{"cell_type":"code","execution_count":6,"id":"89f1ad93","metadata":{"execution":{"iopub.execute_input":"2026-08-27T18:26:30.603558Z","iopub.status.busy":"2026-08-27T18:26:30.603141Z","iopub.status.idle":"2026-08-27T18:29:48.801842Z","shell.execute_reply":"2026-08-27T18:29:48.801007Z"},"papermill":{"duration":198.20882,"end_time":"2026-08-27T18:29:48.803414+00:00","exception":false,"start_time":"2026-08-27T18:26:30.594594+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["======================================================================\n","CAPSTONE — STAGE 05B\n","FAST DISTRIBUTION-AWARE SUBJECT-WISE SPLIT\n","======================================================================\n","\n","Loaded frames: 48,398\n","\n","Creating subject-level statistics...\n","Unique subjects: 25\n","\n","Global statistics:\n","Frames       : 48,398\n","PSPI > 0     : 8,369\n","PSPI >= 4    : 1,697\n","PSPI >= 8    : 330\n","PSPI mean    : 0.4470\n","\n","Searching subject partitions...\n","This time the search operates only on 25 subject-level records.\n","\n","Candidate partitions evaluated: 16,824,500\n","Best score: 0.695904\n","\n","======================================================================\n","SELECTED SUBJECTS\n","======================================================================\n","\n","TRAIN (18 subjects)\n","042-ll042, 047-jl047, 048-aa048, 049-bm049, 052-dr052, 059-fn059, 066-mg066, 080-bn080, 092-ch092, 096-bg096, 103-jk103, 107-hs107, 108-th108, 109-ib109, 115-jy115, 120-kz120, 121-vw121, 123-jh123\n","\n","VALIDATION (4 subjects)\n","043-jh043, 064-ak064, 101-mg101, 124-dn124\n","\n","TEST (3 subjects)\n","095-tv095, 097-gf097, 106-nm106\n","\n","======================================================================\n","FINAL SPLIT DISTRIBUTION\n","======================================================================\n","\n","----------------------------------------------------------------------\n","TRAIN\n","Frames       : 34,185\n","Subjects     : 18\n","Sequences    : 138\n","PSPI mean    : 0.4472\n","PSPI median  : 0.0000\n","PSPI max     : 15.0\n","PSPI > 0     : 5,958 (17.43%)\n","PSPI >= 4    : 1,187 (3.47%)\n","PSPI >= 8    : 251 (0.73%)\n","\n","----------------------------------------------------------------------\n","VALIDATION\n","Frames       : 7,246\n","Subjects     : 4\n","Sequences    : 31\n","PSPI mean    : 0.4522\n","PSPI median  : 0.0000\n","PSPI max     : 12.0\n","PSPI > 0     : 1,248 (17.22%)\n","PSPI >= 4    : 263 (3.63%)\n","PSPI >= 8    : 59 (0.81%)\n","\n","----------------------------------------------------------------------\n","TEST\n","Frames       : 6,967\n","Subjects     : 3\n","Sequences    : 31\n","PSPI mean    : 0.4405\n","PSPI median  : 0.0000\n","PSPI max     : 11.0\n","PSPI > 0     : 1,163 (16.69%)\n","PSPI >= 4    : 247 (3.55%)\n","PSPI >= 8    : 20 (0.29%)\n","\n","======================================================================\n","LEAKAGE VALIDATION\n","======================================================================\n","Train ∩ Validation : 0\n","Train ∩ Test       : 0\n","Validation ∩ Test  : 0\n","\n","======================================================================\n","STAGE 05B COMPLETED SUCCESSFULLY\n","======================================================================\n","\n","Distribution-aware subject-wise split has been created.\n","\n","Saved artifacts:\n","/kaggle/working/capstone/splits/train.csv\n","/kaggle/working/capstone/splits/val.csv\n","/kaggle/working/capstone/splits/test.csv\n","/kaggle/working/capstone/splits/split_summary.json\n","\n","All subject and frame leakage checks passed.\n"]}],"source":["# ============================================================\n","# CAPSTONE — STAGE 05B\n","# Fast Distribution-Aware Subject-Wise Split Selection\n","# ============================================================\n","\n","import json\n","import itertools\n","import random\n","from pathlib import Path\n","\n","import numpy as np\n","import pandas as pd\n","\n","\n","# ------------------------------------------------------------\n","# 1. Configuration\n","# ------------------------------------------------------------\n","\n","SEED = 42\n","\n","random.seed(SEED)\n","np.random.seed(SEED)\n","\n","\n","# ------------------------------------------------------------\n","# 2. Paths\n","# ------------------------------------------------------------\n","\n","CONFIG_PATH = Path(\n","    \"/kaggle/working/capstone/config.json\"\n",")\n","\n","if not CONFIG_PATH.exists():\n","    raise FileNotFoundError(\n","        \"config.json not found. Run Stage 00 first.\"\n","    )\n","\n","\n","with open(\n","    CONFIG_PATH,\n","    \"r\",\n","    encoding=\"utf-8\"\n",") as f:\n","    CONFIG = json.load(f)\n","\n","\n","METADATA_PATH = Path(\n","    CONFIG[\"canonical_metadata\"]\n",")\n","\n","if not METADATA_PATH.exists():\n","    raise FileNotFoundError(\n","        f\"Canonical metadata not found:\\n{METADATA_PATH}\"\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 3. Load metadata\n","# ------------------------------------------------------------\n","\n","print(\"=\" * 70)\n","print(\"CAPSTONE — STAGE 05B\")\n","print(\"FAST DISTRIBUTION-AWARE SUBJECT-WISE SPLIT\")\n","print(\"=\" * 70)\n","\n","df = pd.read_csv(METADATA_PATH)\n","\n","print(\n","    f\"\\nLoaded frames: {len(df):,}\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 4. Create subject-level statistics ONCE\n","# ------------------------------------------------------------\n","\n","print(\"\\nCreating subject-level statistics...\")\n","\n","subject_stats = (\n","    df.groupby(\"subject_group\")\n","    .agg(\n","        frames=(\"frame_id\", \"size\"),\n","        pspi_sum=(\"pspi\", \"sum\"),\n","        positive=(\"pspi\", lambda x: (x > 0).sum()),\n","        moderate=(\"pspi\", lambda x: (x >= 4).sum()),\n","        high=(\"pspi\", lambda x: (x >= 8).sum()),\n","    )\n","    .reset_index()\n",")\n","\n","\n","subjects = sorted(\n","    subject_stats[\"subject_group\"].tolist()\n",")\n","\n","n_subjects = len(subjects)\n","\n","print(\n","    f\"Unique subjects: {n_subjects}\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 5. Convert statistics to dictionaries\n","# ------------------------------------------------------------\n","\n","stats = {}\n","\n","for _, row in subject_stats.iterrows():\n","\n","    subject = row[\"subject_group\"]\n","\n","    stats[subject] = {\n","        \"frames\": int(row[\"frames\"]),\n","        \"pspi_sum\": float(row[\"pspi_sum\"]),\n","        \"positive\": int(row[\"positive\"]),\n","        \"moderate\": int(row[\"moderate\"]),\n","        \"high\": int(row[\"high\"]),\n","    }\n","\n","\n","# ------------------------------------------------------------\n","# 6. Global statistics\n","# ------------------------------------------------------------\n","\n","total_frames = len(df)\n","\n","global_positive = int(\n","    (df[\"pspi\"] > 0).sum()\n",")\n","\n","global_moderate = int(\n","    (df[\"pspi\"] >= 4).sum()\n",")\n","\n","global_high = int(\n","    (df[\"pspi\"] >= 8).sum()\n",")\n","\n","global_pspi_sum = float(\n","    df[\"pspi\"].sum()\n",")\n","\n","global_mean = (\n","    global_pspi_sum / total_frames\n",")\n","\n","\n","print(\"\\nGlobal statistics:\")\n","print(\n","    f\"Frames       : {total_frames:,}\"\n",")\n","print(\n","    f\"PSPI > 0     : {global_positive:,}\"\n",")\n","print(\n","    f\"PSPI >= 4    : {global_moderate:,}\"\n",")\n","print(\n","    f\"PSPI >= 8    : {global_high:,}\"\n",")\n","print(\n","    f\"PSPI mean    : {global_mean:.4f}\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 7. Desired subject counts\n","# ------------------------------------------------------------\n","\n","N_TRAIN = 18\n","N_VAL = 4\n","N_TEST = 3\n","\n","if N_TRAIN + N_VAL + N_TEST != n_subjects:\n","    raise ValueError(\n","        \"Train/validation/test subject counts do not \"\n","        \"equal total number of subjects.\"\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 8. Helper for aggregating subject statistics\n","# ------------------------------------------------------------\n","\n","def aggregate_subjects(subject_list):\n","\n","    frames = 0\n","    pspi_sum = 0.0\n","    positive = 0\n","    moderate = 0\n","    high = 0\n","\n","    for subject in subject_list:\n","\n","        s = stats[subject]\n","\n","        frames += s[\"frames\"]\n","        pspi_sum += s[\"pspi_sum\"]\n","        positive += s[\"positive\"]\n","        moderate += s[\"moderate\"]\n","        high += s[\"high\"]\n","\n","    return {\n","        \"frames\": frames,\n","        \"pspi_sum\": pspi_sum,\n","        \"positive\": positive,\n","        \"moderate\": moderate,\n","        \"high\": high,\n","    }\n","\n","\n","# ------------------------------------------------------------\n","# 9. Fast partition scoring\n","# ------------------------------------------------------------\n","\n","def score_split(\n","    train_subjects,\n","    val_subjects,\n","    test_subjects\n","):\n","\n","    train = aggregate_subjects(train_subjects)\n","    val = aggregate_subjects(val_subjects)\n","    test = aggregate_subjects(test_subjects)\n","\n","    splits = {\n","        \"train\": train,\n","        \"val\": val,\n","        \"test\": test,\n","    }\n","\n","    score = 0.0\n","\n","    # --------------------------------------------------------\n","    # Desired frame proportions\n","    # --------------------------------------------------------\n","\n","    target_ratios = {\n","        \"train\": 0.70,\n","        \"val\": 0.15,\n","        \"test\": 0.15,\n","    }\n","\n","    for name, s in splits.items():\n","\n","        actual_ratio = (\n","            s[\"frames\"] / total_frames\n","        )\n","\n","        target_ratio = target_ratios[name]\n","\n","        score += (\n","            abs(actual_ratio - target_ratio)\n","            * 10.0\n","        )\n","\n","    # --------------------------------------------------------\n","    # Distribution matching\n","    # --------------------------------------------------------\n","\n","    global_positive_rate = (\n","        global_positive / total_frames\n","    )\n","\n","    global_moderate_rate = (\n","        global_moderate / total_frames\n","    )\n","\n","    global_high_rate = (\n","        global_high / total_frames\n","    )\n","\n","    for s in splits.values():\n","\n","        positive_rate = (\n","            s[\"positive\"] / s[\"frames\"]\n","        )\n","\n","        moderate_rate = (\n","            s[\"moderate\"] / s[\"frames\"]\n","        )\n","\n","        high_rate = (\n","            s[\"high\"] / s[\"frames\"]\n","        )\n","\n","        score += (\n","            abs(\n","                positive_rate\n","                - global_positive_rate\n","            )\n","            * 20.0\n","        )\n","\n","        score += (\n","            abs(\n","                moderate_rate\n","                - global_moderate_rate\n","            )\n","            * 30.0\n","        )\n","\n","        score += (\n","            abs(\n","                high_rate\n","                - global_high_rate\n","            )\n","            * 50.0\n","        )\n","\n","    # --------------------------------------------------------\n","    # Mean PSPI matching\n","    # --------------------------------------------------------\n","\n","    for s in splits.values():\n","\n","        split_mean = (\n","            s[\"pspi_sum\"]\n","            / s[\"frames\"]\n","        )\n","\n","        score += (\n","            abs(split_mean - global_mean)\n","            * 5.0\n","        )\n","\n","    # --------------------------------------------------------\n","    # Strong penalties for zero high-pain examples\n","    # --------------------------------------------------------\n","\n","    if test[\"high\"] == 0:\n","        score += 100.0\n","\n","    if val[\"high\"] == 0:\n","        score += 50.0\n","\n","    return score\n","\n","\n","# ------------------------------------------------------------\n","# 10. Search partitions\n","# ------------------------------------------------------------\n","\n","print(\n","    \"\\nSearching subject partitions...\"\n",")\n","\n","print(\n","    \"This time the search operates only on \"\n","    \"25 subject-level records.\"\n",")\n","\n","\n","best_score = float(\"inf\")\n","best_partition = None\n","\n","candidate_count = 0\n","\n","\n","# ------------------------------------------------------------\n","# 11. Enumerate test + validation subjects\n","# ------------------------------------------------------------\n","\n","for test_tuple in itertools.combinations(\n","    subjects,\n","    N_TEST\n","):\n","\n","    test_set = set(test_tuple)\n","\n","    remaining = [\n","        s\n","        for s in subjects\n","        if s not in test_set\n","    ]\n","\n","    for val_tuple in itertools.combinations(\n","        remaining,\n","        N_VAL\n","    ):\n","\n","        val_set = set(val_tuple)\n","\n","        train_set = (\n","            set(remaining)\n","            - val_set\n","        )\n","\n","        train_tuple = tuple(\n","            sorted(train_set)\n","        )\n","\n","        val_tuple_sorted = tuple(\n","            sorted(val_set)\n","        )\n","\n","        test_tuple_sorted = tuple(\n","            sorted(test_set)\n","        )\n","\n","        score = score_split(\n","            train_tuple,\n","            val_tuple_sorted,\n","            test_tuple_sorted\n","        )\n","\n","        candidate_count += 1\n","\n","        if score < best_score:\n","\n","            best_score = score\n","\n","            best_partition = {\n","                \"train\": list(train_tuple),\n","                \"val\": list(val_tuple_sorted),\n","                \"test\": list(test_tuple_sorted),\n","            }\n","\n","\n","print(\n","    f\"\\nCandidate partitions evaluated: \"\n","    f\"{candidate_count:,}\"\n",")\n","\n","print(\n","    f\"Best score: {best_score:.6f}\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 12. Extract final subjects\n","# ------------------------------------------------------------\n","\n","train_subjects = best_partition[\"train\"]\n","val_subjects = best_partition[\"val\"]\n","test_subjects = best_partition[\"test\"]\n","\n","\n","# ------------------------------------------------------------\n","# 13. Build final DataFrames\n","# ------------------------------------------------------------\n","\n","train_df = df[\n","    df[\"subject_group\"].isin(train_subjects)\n","].copy()\n","\n","val_df = df[\n","    df[\"subject_group\"].isin(val_subjects)\n","].copy()\n","\n","test_df = df[\n","    df[\"subject_group\"].isin(test_subjects)\n","].copy()\n","\n","\n","# ------------------------------------------------------------\n","# 14. Leakage checks\n","# ------------------------------------------------------------\n","\n","train_subject_set = set(train_subjects)\n","val_subject_set = set(val_subjects)\n","test_subject_set = set(test_subjects)\n","\n","assert not (\n","    train_subject_set\n","    & val_subject_set\n",")\n","\n","assert not (\n","    train_subject_set\n","    & test_subject_set\n",")\n","\n","assert not (\n","    val_subject_set\n","    & test_subject_set\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 15. Frame assignment check\n","# ------------------------------------------------------------\n","\n","assert (\n","    len(train_df)\n","    + len(val_df)\n","    + len(test_df)\n","    == len(df)\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 16. Statistics printer\n","# ------------------------------------------------------------\n","\n","def print_split_statistics(\n","    name,\n","    split_df\n","):\n","\n","    frames = len(split_df)\n","\n","    positive = int(\n","        (split_df[\"pspi\"] > 0).sum()\n","    )\n","\n","    moderate = int(\n","        (split_df[\"pspi\"] >= 4).sum()\n","    )\n","\n","    high = int(\n","        (split_df[\"pspi\"] >= 8).sum()\n","    )\n","\n","    print(\"\\n\" + \"-\" * 70)\n","    print(name)\n","\n","    print(\n","        f\"Frames       : {frames:,}\"\n","    )\n","\n","    print(\n","        f\"Subjects     : \"\n","        f\"{split_df['subject_group'].nunique():,}\"\n","    )\n","\n","    print(\n","        f\"Sequences    : \"\n","        f\"{split_df['sequence_id'].nunique():,}\"\n","    )\n","\n","    print(\n","        f\"PSPI mean    : \"\n","        f\"{split_df['pspi'].mean():.4f}\"\n","    )\n","\n","    print(\n","        f\"PSPI median  : \"\n","        f\"{split_df['pspi'].median():.4f}\"\n","    )\n","\n","    print(\n","        f\"PSPI max     : \"\n","        f\"{split_df['pspi'].max():.1f}\"\n","    )\n","\n","    print(\n","        f\"PSPI > 0     : \"\n","        f\"{positive:,} \"\n","        f\"({positive / frames * 100:.2f}%)\"\n","    )\n","\n","    print(\n","        f\"PSPI >= 4    : \"\n","        f\"{moderate:,} \"\n","        f\"({moderate / frames * 100:.2f}%)\"\n","    )\n","\n","    print(\n","        f\"PSPI >= 8    : \"\n","        f\"{high:,} \"\n","        f\"({high / frames * 100:.2f}%)\"\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 17. Print selected subjects\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"SELECTED SUBJECTS\")\n","print(\"=\" * 70)\n","\n","print(\n","    f\"\\nTRAIN ({len(train_subjects)} subjects)\"\n",")\n","\n","print(\n","    \", \".join(train_subjects)\n",")\n","\n","print(\n","    f\"\\nVALIDATION ({len(val_subjects)} subjects)\"\n",")\n","\n","print(\n","    \", \".join(val_subjects)\n",")\n","\n","print(\n","    f\"\\nTEST ({len(test_subjects)} subjects)\"\n",")\n","\n","print(\n","    \", \".join(test_subjects)\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 18. Print statistics\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"FINAL SPLIT DISTRIBUTION\")\n","print(\"=\" * 70)\n","\n","print_split_statistics(\n","    \"TRAIN\",\n","    train_df\n",")\n","\n","print_split_statistics(\n","    \"VALIDATION\",\n","    val_df\n",")\n","\n","print_split_statistics(\n","    \"TEST\",\n","    test_df\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 19. Frame leakage checks\n","# ------------------------------------------------------------\n","\n","train_frames = set(\n","    train_df[\"frame_id\"]\n",")\n","\n","val_frames = set(\n","    val_