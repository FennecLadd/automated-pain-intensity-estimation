ot set(train.subject_group)&set(val.subject_group)\nassert not set(train.subject_group)&set(test.subject_group)\nassert not set(val.subject_group)&set(test.subject_group)\nassert not set(train.frame_id)&set(val.frame_id)\nassert not set(train.frame_id)&set(test.frame_id)\nassert not set(val.frame_id)&set(test.frame_id)\nprint(f\"\\nTrain      : {len(train):,}\\nValidation : {len(val):,}\\nTest       : {len(test):,}\")\nprint(\"Stage 05B split : VERIFIED\\nSubject leakage : NONE\\nFrame leakage   : NONE\")\n\nSEED=42;IMG=224;BS=32;WORKERS=2;EPOCHS=8;LR=1e-4;WD=1e-4\ntorch.manual_seed(SEED);np.random.seed(SEED)\nif torch.cuda.is_available():torch.cuda.manual_seed_all(SEED)\ndevice=torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprint(f\"Device : {device}\")\nif torch.cuda.is_available():print(f\"GPU    : {torch.cuda.get_device_name(0)}\")\n\nclass PainDataset(Dataset):\n    def __init__(self,df,tf):self.df=df.reset_index(drop=True);self.tf=tf\n    def __len__(self):return len(self.df)\n    def __getitem__(self,i):\n        r=self.df.iloc[i]\n        return self.tf(Image.open(r.image_path).convert(\"RGB\")),torch.tensor(int(r.pain_class),dtype=torch.long)\n\nmean=[.485,.456,.406];std=[.229,.224,.225]\ntr_tf=transforms.Compose([transforms.Resize((IMG,IMG)),transforms.RandomHorizontalFlip(.5),transforms.ToTensor(),transforms.Normalize(mean,std)])\nva_tf=transforms.Compose([transforms.Resize((IMG,IMG)),transforms.ToTensor(),transforms.Normalize(mean,std)])\ntr=DataLoader(PainDataset(train,tr_tf),BS,shuffle=True,num_workers=WORKERS,pin_memory=True)\nva=DataLoader(PainDataset(val,va_tf),BS,shuffle=False,num_workers=WORKERS,pin_memory=True)\n\nprint(\"\\nLoading pretrained EfficientNet-B0...\")\nmodel=models.efficientnet_b0(weights=models.EfficientNet_B0_Weights.DEFAULT)\nmodel.classifier[1]=nn.Linear(model.classifier[1].in_features,4)\nmodel=model.to(device)\n\n# ---------- Load exact Stage 07 weights ----------\ncw=json.load(open(DATA/\"class_weights.json\"))\nweights_dict=cw[\"weights\"]\nnames=[\"No pain\",\"Low pain\",\"Moderate pain\",\"High pain\"]\nweights=torch.tensor([float(weights_dict[n]) for n in names],dtype=torch.float32,device=device)\nprint(\"\\nClass weights:\",[round(x,4) for x in weights.cpu().tolist()])\n\ncriterion=nn.CrossEntropyLoss(weight=weights)\nopt=torch.optim.AdamW(model.parameters(),lr=LR,weight_decay=WD)\nsched=torch.optim.lr_scheduler.CosineAnnealingLR(opt,T_max=EPOCHS)\n\nhist=[];best=-1\nfor ep in range(1,EPOCHS+1):\n    t=time.time();model.train();ls=0;yt=[];yp=[]\n    for x,y in tr:\n        x,y=x.to(device,non_blocking=True),y.to(device,non_blocking=True)\n        opt.zero_grad(set_to_none=True);z=model(x);loss=criterion(z,y);loss.backward();opt.step()\n        ls+=loss.item()*len(y);yt+=y.cpu().tolist();yp+=z.argmax(1).detach().cpu().tolist()\n    sched.step();tl=ls/len(train);ta=accuracy_score(yt,yp);tf=f1_score(yt,yp,average=\"macro\",zero_division=0)\n\n    model.eval();ls=0;yt=[];yp=[]\n    with torch.no_grad():\n        for x,y in va:\n            x,y=x.to(device,non_blocking=True),y.to(device,non_blocking=True)\n            z=model(x);ls+=criterion(z,y).item()*len(y);yt+=y.cpu().tolist();yp+=z.argmax(1).cpu().tolist()\n    vl=ls/len(val);vaa=accuracy_score(yt,yp);vab=balanced_accuracy_score(yt,yp);vf=f1_score(yt,yp,average=\"macro\",zero_division=0)\n    hist.append([ep,tl,ta,tf,vl,vaa,vab,vf,opt.param_groups[0][\"lr\"],time.time()-t])\n    print(f\"Epoch {ep:02d}/{EPOCHS} | Train Loss {tl:.4f} | Val Loss {vl:.4f} | Val Acc {vaa:.4f} | Val Bal Acc {vab:.4f} | Val Macro-F1 {vf:.4f} | {time.time()-t:.1f}s\")\n    if vf>best:\n        best=vf\n        torch.save({\"stage\":10,\"model\":\"EfficientNet-B0\",\"epoch\":ep,\"model_state_dict\":model.state_dict(),\"optimizer_state_dict\":opt.state_dict(),\"best_val_macro_f1\":best,\"class_weights\":weights.cpu(),\"seed\":SEED,\"image_size\":IMG},OUT/\"best_efficientnet_b0.pth\")\n        print(f\"  ✓ Best checkpoint saved (Macro-F1={best:.4f})\")\n\nh=pd.DataFrame(hist,columns=[\"epoch\",\"train_loss\",\"train_accuracy\",\"train_macro_f1\",\"val_loss\",\"val_accuracy\",\"val_balanced_accuracy\",\"val_macro_f1\",\"lr\",\"time_sec\"])\nh.to_csv(OUT/\"training_history.csv\",index=False)\nsummary={\"stage\":\"10\",\"status\":\"completed\",\"model\":\"EfficientNet-B0\",\"best_epoch\":int(h.loc[h.val_macro_f1.idxmax(),\"epoch\"]),\"best_validation_macro_f1\":float(best),\"resnet18_baseline_macro_f1\":.4390,\"test_evaluation\":False,\"stage05b_split_modified\":False}\nwith open(OUT/\"stage10_summary.json\",\"w\") as f:json.dump(summary,f,indent=2)\n\nprint(\"\\n\"+\"=\"*65);print(\"STAGE 10 COMPLETED SUCCESSFULLY\");print(\"=\"*65)\nprint(f\"Best checkpoint : {OUT/'best_efficientnet_b0.pth'}\")\nprint(f\"Training history: {OUT/'training_history.csv'}\")\nprint(f\"Summary         : {OUT/'stage10_summary.json'}\")\nprint(f\"Best Val Macro-F1: {best:.4f}\")\nprint(\"Test set        : NOT USED\\nStage 05B split : UNCHANGED\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-28T06:02:35.372458Z","iopub.execute_input":"2026-08-28T06:02:35.373292Z","iopub.status.idle":"2026-08-28T06:29:28.701536Z","shell.execute_reply.started":"2026-08-28T06:02:35.373262Z","shell.execute_reply":"2026-08-28T06:29:28.700484Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# CAPSTONE — STAGE 10\n## EfficientNet-B0 Baseline\n\n### Objective\nTrain a pretrained **EfficientNet-B0** model for frame-level 4-class pain classification using the locked **Stage 05B subject-wise split**.\n\n### Configuration\n- Input size: `224 × 224`\n- Backbone: `EfficientNet-B0` pretrained on ImageNet\n- Classes: `No pain`, `Low pain`, `Moderate pain`, `High pain`\n- Batch size: `32`\n- Epochs: `8`\n- Optimizer: `AdamW`\n- Learning rate: `1e-4`\n- Weight decay: `1e-4`\n- Loss: Weighted Cross-Entropy\n- Class weights: Computed from training split only\n- Best model selection: Validation Macro-F1\n- Test set: **Not used**\n\n### Dataset\n| Split | Frames |\n|---|---:|\n| Train | 34,185 |\n| Validation | 7,246 |\n| Test | 6,967 |\n| **Total** | **48,398** |\n\n### Data Integrity\n- Stage 05B split: **UNCHANGED**\n- Subject leakage: **NONE**\n- Frame leakage: **NONE**\n- Test-set contamination: **NONE**\n\n### Results\n\n| Model | Val Macro-F1 | Val Balanced Accuracy |\n|---|---:|---:|\n| ResNet-18 (Stage 09) | 0.4390 | 0.4159 |\n| **EfficientNet-B0 (Stage 10)** | **0.4718** | **0.4681** |\n\nEfficientNet-B0 improves validation Macro-F1 by **0.0328 (~7.5%)** over the ResNet-18 baseline.\n\n**Best epoch:** 5  \n**Best Validation Macro-F1:** 0.4718\n\n### Outputs\n- `models/stage10/best_efficientnet_b0.pth`\n- `models/stage10/training_history.csv`\n- `models/stage10/stage10_summary.json`\n\n### Conclusion\nEfficientNet-B0 provides a stronger frame-level baseline than ResNet-18. However, the current model treats frames independently and does not model temporal dependencies between consecutive facial expressions.\n\n### Next Stage\n**Stage 11 — EfficientNet-B0 + LSTM**\n\nThe EfficientNet-B0 backbone will be used to extract frame-level visual features, which will then be organized into temporal sequences and processed using an **LSTM** for sequence-level pain prediction.","metadata":{}},{"cell_type":"code","source":"# ================================================================\n# CAPSTONE — STAGE 10 CHECKPOINT BACKUP\n# Saves + verifies all artifacts needed to resume at Stage 11\n# ================================================================\nfrom pathlib import Path\nimport shutil,zipfile,hashlib,json,os\n\nBASE=Path(\"/kaggle/working/capstone\")\nBACK=Path(\"/kaggle/working/capstone_backup\")\nZIP=Path(\"/kaggle/working/CAPSTONE_STAGE05B_STAGE10_CHECKPOINT.zip\")\nSHA=Path(\"/kaggle/working/CAPSTONE_STAGE05B_STAGE10_CHECKPOINT.sha256\")\nMAN=BACK/\"backup_manifest.json\"\n\nprint(\"=\"*70)\nprint(\"CAPSTONE — STAGE 10 CHECKPOINT BACKUP\")\nprint(\"=\"*70)\n\n# Required artifacts\nrequired=[\n\"config.json\",\n\"splits/train.csv\",\"splits/val.csv\",\"splits/test.csv\",\"splits/split_summary.json\",\n\"metadata/canonical_metadata.csv\",\"metadata/metadata_summary.json\",\n\"metadata/eda/eda_summary.json\",\"metadata/eda/pain_class_distribution.csv\",\n\"metadata/eda/pain_class_by_split.csv\",\"metadata/eda/pain_class_percentage_by_split.csv\",\n\"metadata/eda/pspi_distribution.csv\",\"metadata/eda/pspi_by_active_au_count.csv\",\n\"metadata/eda/au_distribution.csv\",\"metadata/eda/subject_statistics.csv\",\n\"metadata/eda/sequence_statistics.csv\",\"metadata/eda/frame_continuity.csv\",\n\"metadata/eda/correlation_matrix.csv\",\n\"metadata/stage07/train_model.csv\",\"metadata/stage07/validation_model.csv\",\n\"metadata/stage07/test_model.csv\",\"metadata/stage07/class_weights.json\",\n\"metadata/stage07/stage07_summary.json\",\"metadata/stage08/stage08_summary.json\",\n\"models/stage09/best_resnet18.pth\",\"models/stage09/training_history.csv\",\n\"models/stage09/stage09_summary.json\",\n\"models/stage10/best_efficientnet_b0.pth\",\"models/stage10/training_history.csv\",\n\"models/stage10/stage10_summary.json\"\n]\n\nmissing=[x for x in required if not (BASE/x).exists()]\nif missing:\n    print(\"\\n❌ MISSING FILES:\")\n    for x in missing: print(\"  \",x)\n    raise FileNotFoundError(\"Backup stopped because required files are missing.\")\n\nprint(f\"\\n✓ All {len(required)} required artifacts found\")\n\n# Recreate backup directory\nif BACK.exists(): shutil.rmtree(BACK)\nBACK.mkdir(parents=True)\n\n# Copy artifacts\nfor rel in required:\n    src=BASE/rel\n    dst=BACK/rel\n    dst.parent.mkdir(parents=True,exist_ok=True)\n    shutil.copy2(src,dst)\n\n# Manifest\nfiles=[]\nfor p in BACK.rglob(\"*\"):\n    if p.is_file() and p.name!=\"backup_manifest.json\":\n        h=hashlib.sha256(p.read_bytes()).hexdigest()\n        files.append({\"path\":str(p.relative_to(BACK)),\"size\":p.stat().st_size,\"sha256\":h})\n\nmanifest={\n    \"checkpoint\":\"Stage 05B → Stage 10\",\n    \"resume_stage\":\"11\",\n    \"stage05b_split_locked\":True,\n    \"test_used\":False,\n    \"required_files\":len(files),\n    \"files\":files\n}\nMAN.write_text(json.dumps(manifest,indent=2))\n\n# ZIP backup\nif ZIP.exists(): ZIP.unlink()\nwith zipfile.ZipFile(ZIP,\"w\",zipfile.ZIP_DEFLATED) as z:\n    for p in BACK.rglob(\"*\"):\n        if p.is_file(): z.write(p,p.relative_to(BACK))\n\n# SHA256\ndigest=hashlib.sha256(ZIP.read_bytes()).hexdigest()\nSHA.write_text(digest+\"  \"+ZIP.name+\"\\n\")\n\nprint(\"\\n\"+\"=\"*70)\nprint(\"✓ BACKUP CREATED SUCCESSFULLY\")\nprint(\"=\"*70)\nprint(f\"Files backed up : {len(files)}\")\nprint(f\"ZIP size        : {ZIP.stat().st_size/1024/1024:.2f} MB\")\nprint(f\"SHA256          : {digest}\")\nprint(f\"\\nZIP : {ZIP}\")\nprint(f\"SHA : {SHA}\")\nprint(f\"MAN : {MAN}\")\nprint(\"\\nNEXT SESSION → Restore/verify checkpoint → STAGE 11\")\nprint(\"=\"*70)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-28T06:31:55.317107Z","iopub.execute_input":"2026-08-28T06:31:55.318012Z","iopub.status.idle":"2026-08-28T06:32:06.338018Z","shell.execute_reply.started":"2026-08-28T06:31:55.317975Z","shell.execute_reply":"2026-08-28T06:32:06.337135Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ================================================================\n# CAPSTONE — STAGE 11 | EfficientNet-B0 + LSTM\n# ================================================================\nimport json,time\nfrom pathlib import Path\nimport numpy as np,pandas as pd\nfrom PIL import Image\nimport torch,torch.nn as nn\nfrom torch.utils.data import Dataset,DataLoader\nfrom torchvision import transforms,models\nfrom sklearn.metrics import accuracy_score,balanced_accuracy_score,f1_score\n\nBASE=Path(\"/kaggle/working/capstone\");D=BASE/\"metadata/stage07\";S10=BASE/\"models/stage10\";OUT=BASE/\"models/stage11\"\nOUT.mkdir(parents=True,exist_ok=True);FEAT=OUT/\"features\";FEAT.mkdir(exist_ok=True)\n\nprint(\"=\"*65);print(\"CAPSTONE — STAGE 11\");print(\"EfficientNet-B0 + LSTM\");print(\"=\"*65)\n\n# ---------- Recovery verification ----------\nreq=[D/\"train_model.csv\",D/\"validation_model.csv\",D/\"test_model.csv\",\n     S10/\"best_efficientnet_b0.pth\",D/\"class_weights.json\"]\nmissing=[str(x) for x in req if not x.exists()]\nif missing: raise FileNotFoundError(\"Required Stage 10 artifacts missing:\\n\"+\"\\n\".join(missing))\n\ntrain=pd.read_csv(D/\"train_model.csv\");val=pd.read_csv(D/\"validation_model.csv\");test=pd.read_csv(D/\"test_model.csv\")\nassert (len(train),len(val),len(test))==(34185,7246,6967)\nassert not set(train.subject_group)&set(val.subject_group)\nassert not set(train.subject_group)&set(test.subject_group)\nassert not set(val.subject_group)&set(test.subject_group)\n\nprint(f\"\\nTrain      : {len(train):,}\")\nprint(f\"Validation : {len(val):,}\")\nprint(f\"Test       : {len(test):,}\")\nprint(\"Stage 05B split : VERIFIED\")\nprint(\"Subject leakage : NONE\")\nprint(\"Test set        : NOT USED\")\n\nSEED=42;IMG=224;BS=32;WORKERS=2;SEQ=16;EPOCHS=10;LR=1e-3\ntorch.manual_seed(SEED);np.random.seed(SEED)\nif torch.cuda.is_available():torch.cuda.manual_seed_all(SEED)\ndevice=torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprint(f\"Device : {device}\")\nif torch.cuda.is_available():print(f\"GPU    : {torch.cuda.get_device_name(0)}\")\n\n# ---------- EfficientNet feature extractor ----------\ntf=transforms.Compose([\n    transforms.Resize((IMG,IMG)),transforms.ToTensor(),\n    transforms.Normalize([.485,.456,.406],[.229,.224,.225])\n])\n\ncnn=models.efficientnet_b0(weights=None)\ncnn.classifier[1]=nn.Linear(cnn.classifier[1].in_features,4)\nckpt=torch.load(S10/\"best_efficientnet_b0.pth\",map_location=\"cpu\",weights_only=False)\ncnn.load_state_dict(ckpt[\"model_state_dict\"])\ncnn.classifier=nn.Identity()\ncnn=cnn.to(device).eval()\n\nclass ImgDS(Dataset):\n    def __init__(self,df):self.df=df.res