========================\nimport os,random,numpy as np,pandas as pd,torch\nimport torch.nn as nn\nfrom torch.utils.data import DataLoader,TensorDataset\nfrom sklearn.neighbors import NearestNeighbors\nfrom sklearn.metrics import accuracy_score,balanced_accuracy_score,f1_score\nfrom sklearn.decomposition import PCA\n\nROOT=\"/kaggle/working/capstone\"; F=ROOT+\"/models/stage11/features\"\nOUT=ROOT+\"/models/stage30\"; os.makedirs(OUT,exist_ok=True)\nD=\"cuda\" if torch.cuda.is_available() else \"cpu\"; SEQ=16; EPOCHS=30; BS=128\nnp.random.seed(42); random.seed(42); torch.manual_seed(42)\n\n# ---------- Load features ----------\ndef loadfeat(name):\n    p=F+\"/\"+name+\"_features.pt\"\n    if os.path.exists(p): return torch.load(p,map_location=\"cpu\",weights_only=False).numpy()\n    return np.load(F+\"/\"+name+\"_features.npy\")\n\nXtr=loadfeat(\"train\"); Xv=loadfeat(\"validation\")\ntr=pd.read_csv(ROOT+\"/metadata/stage07/train_model.csv\")\nva=pd.read_csv(ROOT+\"/metadata/stage07/validation_model.csv\")\n\n# ---------- Robust column detection ----------\ndef col(df,names):\n    for n in names:\n        if n in df.columns:return n\n    raise ValueError(f\"Missing column. Available: {list(df.columns)}\")\nSC=col(tr,[\"subject_group\",\"subject_id\",\"subject\",\"patient_id\"])\nFC=col(tr,[\"frame_number\",\"frame\",\"frame_id\"])\nLC=col(tr,[\"pain_class\",\"label\",\"pain_label\",\"class\",\"target\"])\n\n# ---------- Build contiguous windows ----------\ndef windows(df,X):\n    df=df.copy().reset_index(drop=True); out=[]\n    for _,g in df.groupby(SC,sort=False):\n        g=g.sort_values(FC).reset_index()\n        fr=pd.to_numeric(g[FC],errors=\"coerce\").to_numpy()\n        for s in range(len(g)-SEQ+1):\n            a=fr[s:s+SEQ]\n            if np.isfinite(a).all() and np.all(np.diff(a)==1):\n                ix=g[\"index\"].to_numpy()[s:s+SEQ]\n                out.append((X[ix],int(g.iloc[s+SEQ-1][LC])))\n    return np.asarray([x for x,y in out],dtype=np.float32)