:37.34987Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"| Model                                     | Test Accuracy | Test Bal. Acc. | Test Macro-F1 |\n| ----------------------------------------- | ------------: | -------------: | ------------: |\n| Stage 17 Fine-tuned EfficientNet + BiLSTM |    **0.8294** |     **0.2543** |    **0.2351** |\n| Stage 19 Focal BiLSTM                     |        0.8241 |         0.2511 |        0.2281 |\n| Stage 13 + calibration                    |        0.8234 |         0.2500 |        0.2258 |\n| Stage 14 Temporal LSTM                    |        0.8243 |         0.2482 |        0.2259 |\n","metadata":{}},{"cell_type":"markdown","source":"## Stage 26 — Subject-Aware Augmented Temporal Training\n\n**Goal:** Improve minority-class generalization using training-only augmentation and balanced window sampling.\n\n**Baseline:** Stage 19 Focal Temporal BiLSTM  \n**Train:** Stage 05B training subjects only  \n**Validation:** Unaugmented Stage 05B validation subjects  \n**Test:** NOT USED\n\n**Augmentation:**\n- Random horizontal flip\n- Mild rotation\n- Mild brightness/contrast variation\n- Minority-class oversampling\n- No augmentation on validation/test\n\n**Model:** EfficientNet-B0 features + Temporal BiLSTM  \n**Loss:** Focal Loss  \n**Selection metric:** Validation Macro-F1  \n**Early stopping:** Patience 8","metadata":{}},{"cell_type":"code","source":"# ================================================================\n# CAPSTONE — STAGE 26\n# Subject-Aware Augmented Temporal BiLSTM\n# ================================================================\nimport os,random,json\nfrom pathlib import Path\nimport numpy as np,pandas as pd,torch\nimport torch.nn as nn\nfrom torch.utils.data import Dataset,DataLoader,WeightedRandomSampler\nfrom torchvision import models,transforms\nfrom PIL import Image\nfrom sklearn.metrics import accuracy_score,balanced_accuracy_score,f1_score\n\nROOT=Path(\"/kaggle/working/capstone\"); OUT=ROOT/\"models/stage26\"; OUT.mkdir(parents=True,exist_ok=True)\nD=torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\"); SEQ=16; BS=64; EPOCHS=40; PATIENCE=8\n\ntrain=pd.read_csv(ROOT/\"metadata/stage07/train_model.csv\")\nval=pd.read_csv(ROOT/\"metadata/stage07/validation_model.csv\")\nSC,FC,LC=\"subject_group\",\"frame_number\",\"pain_class\"\nprint(f\"Train frames: {len(train):,} | Validation frames: {len(val):,} | Device: {D}\")\n\n# -------- contiguous temporal windows --------\ndef windows(df):\n    out=[]\n    for sub,g in df.groupby(SC,sort=False):\n        g=g.sort_values(FC).reset_index(drop=True)\n        f=pd.to_numeric(g[FC],errors=\"coerce\").to_numpy()\n        for s in range(len(g)-SEQ+1):\n            if np.all(np.diff(f[s:s+SEQ])==1):\n                z=g.iloc[s:s+SEQ]\n                out.append((z.image_path.tolist(),int(z.iloc[-1][LC]),sub))\n    return out\n\ntw,vw=windows(train),windows(val)\nprint(\"Train windows:\",len(tw),\"Validation windows:\",len(vw))\nprint(\"Original train:\",np.bincount([x[1] for x in tw],minlength=4))\nprint(\"Validation:\",np.bincount([x[1] for x in vw],minlength=4))\n\n# -------- EfficientNet feature extractor --------\nnet=models.efficientnet_b0(weights=models.EfficientNet_B0_Weights.DEFAULT)\nnet.classifier=nn.Identity(); net.eval().to(D)\nfor p in net.parameters(): p.requires_grad=False\n\naug=transforms.Compose([\n    transforms.Resize((224,224)),\n    transforms.RandomHorizontalFlip(p=.5),\n    transforms.RandomRotation(8),\n    transforms.ColorJitter(brightness=.12,contrast=.12),\n    transforms.ToTensor(),\n    transforms.Normalize([.485,.456,.406],[.229,.224,.225])\n])\nplain=models.EfficientNet_B0_Weights.DEFAULT.transforms()\n\ndef extract(ws,augment=False):\n    X=np.empty((len(ws),SEQ,1280),np.float32); y=np.empty(len(ws),np.int64)\n    for i,(paths,label,_) in enumerate(ws):\n        ims=torch.stack([(aug if augment else plain)(Image.open(p).convert(\"RGB\")) for p in paths]).to(D)\n        with torch.no_grad(): X[i]=net(ims).cpu().numpy()\n        y[i]=label\n        if (i+1)%500==0: print(f\"  features {i+1}/{len(ws)}\",end=\"\\r\")\n    return X,y\n\n# Extract training features with augmentation; validation stays untouched.\nXtr,ytr=extract(tw,True); Xv,yv=extract(vw,False)\nnp.save(OUT/\"train_features_aug.npy\",Xtr); np.save(OUT/\"val_features.npy\",Xv)\nnp.save(OUT/\"train_labels.npy\",ytr); np.save(OUT/\"val_labels.npy\",yv)\n\n# -------- balanced sampling --------\nclass DS(Dataset):\n    def __init__(self,X,y): self.X=torch.from_numpy(X); self.y=torch.from_numpy(y)\n    def __len__(self): return len(self.y)\n    def __getitem__(self,i): return self.X[i],self.y[i]\n\nds=DS(Xtr,ytr); counts=np.bincount(ytr,minlength=4); w=1/np.maximum(counts,1)\nsampler=WeightedRandomSampler(torch.tensor(w[ytr],dtype=torch.double),len(ytr),replacement=True)\ndl=DataLoader(ds,BS,sampler=sampler,num_workers=0,pin_memory=True)\nvl=DataLoader(DS(Xv,yv),BS,shuffle=False,num_workers=0,pin_memory=True)\n\n# -------- Focal Temporal BiLSTM --------\nclass Model(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.inp=nn.Sequential(nn.Linear(1280,256),nn.LayerNorm(256),nn.ReLU(),nn.Dropout(.25))\n        self.lstm=nn.LSTM(256,128,2,batch_first=True,bidirectional=True,dropout=.25)\n        self.head=nn.Sequential(nn.Linear(256,128),nn.ReLU(),nn.Dropout(.3),nn.Linear(128,4))\n    def forward(self,x): return self.head(self.lstm(self.inp(x))[0][:,-1])\n\nm=Model().to(D); opt=torch.optim.AdamW(m.parameters(),lr=2e-4,weight_decay=1e-4)\ndef focal(logits,y,gamma=2):\n    ce=nn.functional.cross_entropy(logits,y,reduction=\"none\")\n    return ((1-torch.exp(-ce))**gamma*ce).mean()\n\nbest=-1; bad=0\nfor ep in range(1,EPOCHS+1):\n    m.train(); tl=0\n    for x,y in dl:\n        x,y=x.to(D),y.to(D); opt.zero_grad(); loss=focal(m(x),y); loss.backward(); opt.step(); tl+=loss.item()*len(y)\n    m.eval(); P=[];Y=[]; vloss=0\n    with torch.no_grad():