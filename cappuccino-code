pain_class\"]=pd.cut(df.pspi,[-.1,.5,3.5,6.5,np.inf],labels=order)\n","\n","print(\"=\"*65)\n","print(\"CAPSTONE — STAGE 06\")\n","print(\"Exploratory Data Analysis & Dataset Quality\")\n","print(\"=\"*65)\n","print(f\"\\nFrames: {len(df):,} | Subjects: {df.subject_group.nunique()} | Sequences: {df.sequence_id.nunique()}\")\n","\n","# PSPI\n","print(\"\\n\"+\"=\"*65+\"\\nPSPI STATISTICS\\n\"+\"=\"*65)\n","print(df.pspi.describe())\n","pspi_dist=df.pspi.value_counts().sort_index()\n","print(\"\\nPSPI distribution:\\n\",pspi_dist)\n","\n","# Pain classes\n","print(\"\\n\"+\"=\"*65+\"\\nPAIN CLASS DISTRIBUTION\\n\"+\"=\"*65)\n","pain=df.pain_class.value_counts().reindex(order).fillna(0).astype(int)\n","pain_tbl=pd.DataFrame({\"count\":pain,\"percentage\":(pain/len(df)*100).round(2)})\n","print(pain_tbl)\n","\n","split_cnt=pd.crosstab(df.pain_class,df.split).reindex(order).fillna(0).astype(int)\n","split_pct=(split_cnt.div(split_cnt.sum(axis=0),axis=1)*100).round(2)\n","print(\"\\nPain classes by split:\\n\",split_cnt)\n","print(\"\\nPercentages by split:\\n\",split_pct)\n","\n","# FACS\n","print(\"\\n\"+\"=\"*65+\"\\nFACS STATISTICS\\n\"+\"=\"*65)\n","active=(df.num_active_aus>0).sum()\n","print(f\"Frames with active AU : {active:,}\")\n","print(f\"Frames without AU     : {len(df)-active:,}\")\n","print(f\"Mean active AUs/frame : {df.num_active_aus.mean():.4f}\")\n","print(f\"Maximum active AUs    : {df.num_active_aus.max()}\")\n","print(f\"Maximum AU intensity  : {df.max_au_intensity.max():.1f}\")\n","\n","# PSPI vs active AU count\n","pspi_au=df.groupby(\"num_active_aus\").pspi.agg([\"count\",\"mean\",\"median\",\"max\"]).reset_index()\n","print(\"\\n\"+\"=\"*65+\"\\nPSPI VS ACTIVE AU COUNT\\n\"+\"=\"*65)\n","print(pspi_au.to_string(index=False))\n","\n","# AU distribution from active_aus dictionaries\n","aus=[4,6,7,9,10,12,15,20,25,26,27,43]\n","def au_active(a):\n","    try:return {int(k):float(v) for k,v in json.loads(a).items()}\n","    except:return {}\n","\n","au_dict=df.active_aus.apply(au_active)\n","au_dist=pd.DataFrame([{\"au\":au,\"active_frames\":sum(au in x and x[au]>0 for x in au_dict),\n","                       \"percentage\":round(sum(au in x and x[au]>0 for x in au_dict)/len(df)*100,4)} for au in aus])\n","print(\"\\n\"+\"=\"*65+\"\\nACTION UNIT DISTRIBUTION\\n\"+\"=\"*65)\n","print(au_dist.to_string(index=False))\n","\n","# Subject statistics\n","sub=df.groupby(\"subject_group\").agg(\n","    frames=(\"pspi\",\"count\"),sequences=(\"sequence_id\",\"nunique\"),\n","    pspi_mean=(\"pspi\",\"mean\"),pspi_std=(\"pspi\",\"std\"),pspi_max=(\"pspi\",\"max\"),\n","    pain_frames=(\"pain_class\",lambda x:(x!=\"No pain\").sum()),\n","    high_pain_frames=(\"pain_class\",lambda x:(x==\"High pain\").sum())\n",").fillna(0).sort_values(\"pspi_mean\",ascending=False)\n","print(\"\\n\"+\"=\"*65+\"\\nSUBJECT STATISTICS\\n\"+\"=\"*65)\n","print(sub.to_string())\n","\n","# Sequence statistics + frame continuity\n","seq_len=df.groupby(\"sequence_id\").size()\n","gaps=missing=0\n","for _,g in df.groupby(\"sequence_id\"):\n","    f=np.sort(g.frame_number.astype(int).unique())\n","    m=len(np.setdiff1d(np.arange(f.min(),f.max()+1),f))\n","    if m:gaps+=1; missing+=m\n","\n","print(\"\\n\"+\"=\"*65+\"\\nSEQUENCE STATISTICS\\n\"+\"=\"*65)\n","print(f\"Sequences: {len(seq_len)}\")\n","print(seq_len.describe())\n","print(\"\\n\"+\"=\"*65+\"\\nFRAME CONTINUITY\\n\"+\"=\"*65)\n","print(f\"Sequences checked     : {len(seq_len)}\")\n","print(f\"Sequences with gaps   : {gaps}\")\n","print(f\"Missing frame numbers : {missing}\")\n","\n","# Correlation\n","corr=df[[\"pspi\",\"num_active_aus\",\"max_au_intensity\"]].corr()\n","print(\"\\n\"+\"=\"*65+\"\\nCORRELATION\\n\"+\"=\"*65)\n","print(corr.round(4))\n","\n","# Save tables\n","pspi_dist.to_csv(EDA/\"pspi_distribution.csv\",header=[\"count\"])\n","pain_tbl.to_csv(EDA/\"pain_class_distribution.csv\")\n","split_cnt.to_csv(EDA/\"pain_class_by_split.csv\")\n","split_pct.to_csv(EDA/\"pain_class_percentage_by_split.csv\")\n","pspi_au.to_csv(EDA/\"pspi_by_active_au_count.csv\",index=False)\n","au_dist.to_csv(EDA/\"au_distribution.csv\",index=False)\n","sub.to_csv(EDA/\"subject_statistics.csv\")\n","seq_len.to_csv(EDA/\"sequence_statistics.csv\",header=[\"frames\"])\n","corr.to_csv(EDA/\"correlation_matrix.csv\")\n","pd.DataFrame({\"sequences_checked\":[len(seq_len)],\"gaps\":[gaps],\"missing_frames\":[missing]}).to_csv(EDA/\"frame_continuity.csv\",index=False)\n","\n","# Figures\n","plt.figure(figsize=(8,4)); pspi_dist.plot.bar(); plt.title(\"PSPI Distribution\"); plt.tight_layout(); plt.savefig(FIG/\"01_pspi_distribution.png\",dpi=180); plt.close()\n","plt.figure(figsize=(6,4)); pain.plot.bar(); plt.title(\"Pain Classes\"); plt.tight_layout(); plt.savefig(FIG/\"02_pain_classes.png\",dpi=180); plt.close()\n","plt.figure(figsize=(7,4)); split_cnt.T.plot.bar(ax=plt.gca()); plt.title(\"Pain by Split\"); plt.tight_layout(); plt.savefig(FIG/\"03_pspi_by_split.png\",dpi=180); plt.close()\n","plt.figure(figsize=(8,4)); plt.bar(au_dist.au.astype(str),au_dist.active_frames); plt.title(\"AU Activity\"); plt.tight_layout(); plt.savefig(FIG/\"04_au_activity.png\",dpi=180); plt.close()\n","plt.figure(figsize=(7,4)); plt.plot(pspi_au.num_active_aus,pspi_au[\"mean\"],marker=\"o\"); plt.title(\"PSPI vs Active AU Count\"); plt.tight_layout(); plt.savefig(FIG/\"05_pspi_vs_au_count.png\",dpi=180); plt.close()\n","plt.figure(figsize=(9,6)); sub.sort_values(\"pspi_mean\").pspi_mean.plot.barh(); plt.title(\"Subject Mean PSPI\"); plt.tight_layout(); plt.savefig(FIG/\"06_subject_pspi.png\",dpi=180); plt.close()\n","plt.figure(figsize=(7,4)); plt.hist(seq_len.values,bins=20); plt.title(\"Sequence Lengths\"); plt.tight_layout(); plt.savefig(FIG/\"07_sequence_lengths.png\",dpi=180); plt.close()\n","\n","# Summary\n","summary={\"stage\":\"06\",\"status\":\"completed\",\"frames\":len(df),\"subjects\":df.subject_group.nunique(),\n","\"sequences\":df.sequence_id.nunique(),\"locked_sp