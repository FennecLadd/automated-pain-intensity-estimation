========================\nimport os,json,time,numpy as np,pandas as pd,torch\nimport torch.nn as nn\nfrom torch.utils.data import TensorDataset,DataLoader,WeightedRandomSampler\nfrom sklearn.metrics import accuracy_score,balanced_accuracy_score,f1_score\nfrom pathlib import Path\n\nROOT=Path(\"/kaggle/working/capstone\")\nFEAT=ROOT/\"models/stage11/features\"\nOUT=ROOT/\"models/stage15\"; OUT.mkdir(parents=True,exist_ok=True)\ndevice=torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprint(\"=\"*65,\"\\nCAPSTONE — STAGE 15\\nImbalance-Aware Temporal LSTM\\n\"+\"=\"*65)\n\ntrain_df=pd.read_csv(ROOT/\"metadata/stage07/train_model.csv\")\nval_df=pd.read_csv(ROOT/\"metadata/stage07/validation_model.csv\")\nXtr=torch.load(FEAT/\"train_features.pt\",map_location=\"cpu\").float()\nXva=torch.load(FEAT/\"validation_features.pt\",map_location=\"cpu\").float()\nif isinstance(Xtr,dict): Xtr=Xtr[\"features\"]\nif isinstance(Xva,dict): Xva=Xva[\"features\"]\n\ndef make_windows(X,df,L=16):\n    xs,ys=[],[]\n    for sid,g in df.groupby(\"sequence_id\",sort=False):\n        idx=g.index.to_numpy()\n        # contiguous rows are already preserved in canonical split\n        pos=np.searchsorted(df.index.to_numpy(),idx)\n        if len(pos)<L: continue\n        for j in range(0,len(pos)-L+1):\n            p=pos[j:j+L]\n            xs.append(X[p]); y=g.iloc[j:j+L][\"label\"].to_numpy()\n            # majority/last-frame target; use max pain class in window\n            ys.append(int(np.max(y)))\n    return torch.stack(xs),torch.tensor(ys,dtype=torch.long)\n\n# use frame labels from model-ready files\nif \"label\" not in train_df.columns:\n    train_df[\"label\"]=pd.cut(train_df.pspi,[-1,0,3,6,99],labels=False).astype(int)\nif \"label\" not in val_df.columns:\n    val_df[\"label\"]=pd.cut(val_df.pspi,[-1,0,3,6,99],labels=False).astype(int)\n\n# safer window construction directly from sequence groups\ndef windows(X,df,L=16):\n    xs,ys=[],[]\n    for _,g in df.groupby(\"sequence_id\",sort=False):\n        ids=g.index.to_numpy()\n        # map dataframe indices to feature tensor positions\n        loc=df.index.get_indexer(ids)\n        if len(loc)<L: continue\n        for j in range(len(loc)-L+1):\n            p=loc[j:j+L]\n            xs.append(X[p]); ys.append(int(g.iloc[j:j+L][\"label\"].max()))\n    return torch.stack(xs),torch.tensor(ys)\n\nXtr,Ytr=windows(Xtr,train_df); Xva,Yva=windows(Xva,val_df)\nprint(f\"Train windows : {len(Ytr)} | Validation windows : {len(Yva)}\")\nprint(\"Train distribution:\",np.bincount(Ytr.numpy(),minlength=4).tolist())\nprint(\"Validation distribution:\",np.bincount(Yva.numpy(),minlength=4).tolist())\n\n# class-balanced sampling\ncnt=np.bincount(Ytr.numpy(),minlength=4).astype(float)\ncls_w=len(Ytr)/(4*np.maximum(cnt,1))\nsample_w=torch.tensor(cls_w[Ytr.numpy()],dtype=torch.double)\nsampler=WeightedRandomSampler(sample_w,len(sample_w),replacement=True)\ntr_loader=DataLoader(TensorDataset(Xtr,Ytr),batch_size=64,sampler=sampler)\nva_loader=DataLoader(TensorDataset(Xva,Yva),batch_size=128,shuffle=False)\n\nclass TemporalLSTM(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.inp=nn.Sequential(nn.Linear(1280,256),nn.LayerNorm(256),nn.ReLU(),nn.Dropout(.25))\n        self.lstm=nn.LSTM(256,128,2,batch_first=True,bidirectional=True,dropout=.25)\n        self.attn=nn.Sequential(nn.Linear(256,64),nn.Tanh(),nn.Linear(64,1))\n        self.head=nn.Sequential(nn.Linear(256,128),nn.ReLU(),nn.Dropout(.35),nn.Linear(128,4))\n    def forward(self,x):\n        x=self.inp(x); h,_=self.lstm(x)\n        a=torch.softmax(self.attn(h),1); x=(h*a).sum(1)\n        return self.head(x)\n\nclass FocalLoss(nn.Module):\n    def __init__(self,alpha,gamma=2):\n        super().__init__(); self.alpha=alpha; self.gamma=gamma\n    def forward(self,z,y):\n        ce=nn.functional.cross_entropy(z,y,weight=self.alpha,reduction=\"none\")\n        pt=torch.exp(-ce); return ((1-pt)**self.gamma*ce).mean()\n\n# moderate clipping prevents extreme high-pain domination\nw=np.sqrt(cls_w); w=w/w.mean()\nweights=torch.tensor(w,dtype=torch.float32,device=device)\nprint(\"Loss weights:\",[round(float(x),4) for x in weights])\n\nmodel=TemporalLSTM().to(device)\nloss_fn=FocalLoss(weights,gamma=2)\nopt=torch.optim.AdamW(model.parameters(),lr=3e-4,weight_decay=1e-4)\nsched=torch.optim.lr_scheduler.ReduceLROnPlateau(opt,mode=\"max\",factor=.5,patience=3,min_lr=1e-6)\n\nbest=-1; best_epoch=0; patience=8; stale=0\nhist=[]\n\nfor ep in range(1,51):\n    t=time.time(); model.train(); tl=0\n    for x,y in tr_loader:\n        x,y=x.to(device),y.to(device); opt.zero_grad()\n        z=model(x); loss=loss_fn(z,y); loss.backward()\n        torch.nn.utils.clip_grad_norm_(model.parameters(),1.0); opt.step()\n        tl+=loss.item()*len(y)\n    model.eval(); P=[];T=[];vl=0\n    with torch.no_grad():\n        for x,y in va_loader:\n            x,y=x.to(device),y.to(device); z=model(x)\n            vl+=loss_fn(z,y).item()*len(y); P.extend(z.argmax(1).cpu().numpy()); T.extend(y.cpu().numpy())\n    acc=accuracy_score(T,P); bal=balanced_accuracy_score(T,P); mf=f1_score(T,P,average=\"macro\",zero_division=0)\n    sched.step(mf); hist.append([ep,tl/len(Ytr),vl/len(Yva),acc,bal,mf,opt.param_groups[0][\"lr\"]])\n    print(f\"Epoch {ep:02d}/50 | Train {tl/len(Ytr):.4f} | Val {vl/len(Yva):.4f} | Acc {acc:.4f} | BalAcc {bal:.4f} | Macro-F1 {mf:.4f} | {time.time()-t:.1f}s\")\n    if mf>best:\n        best=mf; best_epoch=ep; stale=0\n        torch.save(model.state_dict(),OUT/\"best_imbalance_temporal_lstm.pth\")\n        print(f\"  ✓ Best checkpoint saved (Macro-F1={best:.4f})\")\n    else: stale+=1\n    if stale>=patience:\n        print(f\"  Early stopping after {patience} epochs without improvement.\")\n        break\n\npd.DataFrame(hist,columns=[\"epoch\",\"train_loss\",\"val_loss\",\"val_accuracy\",\"val_balanced_accuracy\",\"val_macro_f1\",\"lr\"]).to_csv(OUT/\"training_history.csv\",index=False)\njson.dump({\"stage\":\"15\",\"status\":\"completed\",\"best_val_macro_f1\":best,\"best_epoch\":best_epoch,\"epochs_run\":ep,\"train_windows\":len(Ytr),\"validation_windows\":len(Yva),\"test_used\":False,\"stage05b_split_modified\":False},open(OUT/\"stage15_summary.json\",\"w\"),indent=2)\n\nprint(\"\\n\"+\"=\"*65)\nprint(\"STAGE 15 COMPLETED SUCCESSFULLY\")\nprint(\"=\"*65)\nprint(\"Best checkpoint :\",OUT/\"best_imbalance_temporal_lstm.pth\")\nprint(\"Best Val Macro-F1:\",round(best,4),\" | Best Epoch:\",best_epoch)\nprint(\"Test set : NOT USED\")\nprint(\"Stage 05B split : UNCHANGED\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-28T17:40:05.209618Z","iopub.execute_input":"2026-08-28T17:40:05.21005Z","iopub.status.idle":"2026-08-28T17:42:08.025704Z","shell.execute_reply.started":"2026-08-28T17:40:05.210021Z","shell.execute_reply":"2026-08-28T17:42:08.024953Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ================================================================\n# CAPSTONE — STAGE 16\n# Optimized Fine-Tuned EfficientNet-B0 + Temporal BiLSTM\n# ================================================================\nimport os, json, time, copy\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nfrom PIL import Image\n\nimport torch\nimport torch.nn as nn\nfrom torch.utils.data import Dataset, DataLoader\nfrom torchvision import models, transforms\nfrom sklearn.metrics import accuracy_score, balanced_accuracy_score, f1_score\n\n# ---------------- CONFIG ----------------\nROOT=Path(\"/kaggle/working/capstone\")\nOUT=ROOT/\"models\"/\"stage16\"; FEAT=OUT/\"features\"\nOUT.mkdir(parents=True,exist_ok=True); FEAT.mkdir(parents=True,exist_ok=True)\n\ndevice=torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nN_GPU=torch.cuda.device_count()\nBATCH=128 if N_GPU>1 else 64\nSEQ_LEN=16; STRIDE=4\nEFF_EPOCHS=4; TEMP_EPOCHS=40; PATIENCE=8\n\nif device.type==\"cuda\":\n    torch.backends.cudnn.benchmark=True\n\nprint(\"=\"*65)\nprint(\"CAPSTONE — STAGE 16\")\nprint(\"Optimized Fine-Tuned EfficientNet-B0 + Temporal BiLSTM\")\nprint(\"=\"*65)\nprint(f\"Train frames : {len(train):,} | Validation : {len(val):,}\")\nprint(\"Stage 05B split : VERIFIED\")\nprint(\"Test set : NOT USED\")\nprint(f\"Device : {device} | GPUs : {N_GPU}\")\nif N_GPU: print(\"GPU:\",torch.cuda.get_device_name(0))\n\n# ---------------- LABELS ----------------\nLABEL_MAP={\"No pain\":0,\"Low pain\":1,\"Moderate pain\":2,\"High pain\":3}\n\ndef fix_labels(df):\n    df=df.copy()\n    if \"label\" in df.columns:\n        df[\"label\"]=df[\"label\"].astype(int)\n    elif \"pain_class\" in df.columns:\n        df[\"label\"]=df[\"pain_class\"].map(LABEL_MAP).astype(int)\n    else:\n        raise ValueError(f\"Missing label column: {list(df.columns)}\")\n    return df\n\ntrain=fix_labels(train); val=fix_labels(val)\n\n# ---------------- DATASET ----------------\ntfm=transforms.Compose([\n    transforms.Resize((224,224)),\n    transforms.ToTensor(),\n    transforms.Normalize([.485,.456,.406],[.229,.224,.225])\n])\n\nclass ImageDS(Dataset):\n    def __init__(self,df): self.df=df.reset_index(drop=True)\n    def __len__(self): return len(self.df)\n    def __getitem__(self,i):\n        r=self.df.iloc[i]\n        return tfm(Image.open(r.image_path).convert(\"RGB\")),int(r.label)\n\nNW=min(4,os.cpu_count() or 2)\n\ntr_loader=DataLoader(ImageDS(train),batch_size=BATCH,shuffle=True,\n                      num_workers=NW,pin_memory=True,persistent_workers=True)\nva_loader=DataLoader(ImageDS(val),batch_size=BATCH,shuffle=False,\n                      num_workers=NW,pin_memory=True,persistent_workers=True)\n\n# ---------------- EFFICIENTNET ----------------\neff=models.efficientnet_b0(weights=models.EfficientNet_B0_Weights.DEFAULT)\n\n# Load Stage 10 checkpoint when available: better starting point.\nstage10=ROOT/\"models\"/\"stage10\"/\"best_efficientnet_b0.pth\"\nif stage10.exists():\n    state=torch.load(stage10,map_location=\"cpu\",weights_only=False)\n    if \"state_dict\" in state: state=state[\"state_dict\"]\n    state={k.replace(\"module.\",\"\"):v for k,v in state.items()}\n    eff.load_state_dict(state,strict=False)\n    print(\"✓ Stage 10 checkpoint loaded\")\nelse:\n    print(\"⚠ Stage 10 checkpoint not found; using ImageNet initialization\")\n\nfor p in eff.parameters(): p.requires_grad=False\nfor p in eff.features[-1].parameters(): p.requires_grad=True\n\neff.classifier[1]=nn.Linear(eff.classifier[1].in_features,4)\nfor p in eff.classifier.parameters(): p.requires_grad=True\n\neff=eff.to(device)\nif N_GPU>1:\n    eff=nn.DataParallel(eff)\n    print(\"✓ DataParallel enabled across 2 GPUs\")\n\n# Square-root inverse-frequency weights: less aggressive than\n# Stage 09's raw inverse-frequency weighting.\ncnt=np.bincount(train.label.values,minlength=4).astype(float)\ncw=1/np.sqrt(cnt)\ncw=cw/cw.mean()\ncw=torch.tensor(cw,dtype=torch.float32,device=device)\n\nprint(\"Train distribution:\",cnt.astype(int).tolist())\nprint(\"EfficientNet weights:\",[round(x,4) for x in cw.cpu().tolist()])\n\ncriterion=nn.CrossEntropyLoss(weight=cw)\noptimizer=torch.optim.AdamW(\n    [p for p in eff.parameters() if p.requires_grad],\n    lr=1e-4,weight_decay=1e-4\n)\nscaler=torch.amp.GradScaler(\"cuda\",enabled=device.type==\"cuda\")\n\n# ---------------- EFFICIENTNET FINE-TUNING ----------------\nbest_eff_f1=-1\nbest_eff_state=None\n\nprint(\"\\nFine-tuning EfficientNet...\")\nfor ep in range(1,EFF_EPOCHS+1):\n    t0=time.time(); eff.train(); total=0\n    for bi,(x,y) in enumerate(tr_loader,1):\n        x=x.to(device,non_blocking=True)\n        y=y.to(device,non_blocking=True)\n        optimizer.zero_grad(set_to_none=True)\n        with torch.amp.autocast(\"cuda\",enabled=device.type==\"cuda\"):\n            loss=criterion(eff(x),y)\n        scaler.scale(loss).backward()\n        scaler.step(optimizer); scaler.update()\n        total+=loss.item()*len(y)\n\n        if bi%100==0 or bi==len(tr_loader):