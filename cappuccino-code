:\n        g=g.sort_values(\"frame_number\").reset_index()\n        f=pd.to_numeric(g.frame_number,errors=\"coerce\").to_numpy()\n        for s in range(len(g)-SEQ+1):\n            if np.all(np.diff(f[s:s+SEQ])==1):\n                out.append(X[g.index.to_numpy()[s:s+SEQ]])\n                y.append(int(g.iloc[s+SEQ-1].pain_class))\n    return np.asarray(out,dtype=\"float32\"),np.asarray(y)\n\n# train features: reuse Stage-11 if available, otherwise extract\nTRF=ROOT/\"models/stage11/features/train_features.pt\"\nif not TRF.exists(): raise FileNotFoundError(f\"Missing: {TRF}\")\nXt=torch.load(TRF,map_location=\"cpu\",weights_only=False).numpy().astype(\"float32\")\n\n# IMPORTANT: window first, then ADASYN on flattened windows\nXtr,ytr=windows(train,Xt); Xval,yval=windows(val,Xv)\nprint(f\"Train windows: {len(Xtr):,} | Validation: {len(Xval):,}\")\nprint(\"Original train:\",np.bincount(ytr,minlength=C))\nprint(\"Validation:\",np.bincount(yval,minlength=C))\n\n# ---------- conservative ADASYN ----------\nflat=Xtr.reshape(len(Xtr),-1)\ncounts=np.bincount(ytr,minlength=C)\ntarget={1:min(counts[1]*2,8000),2:min(counts[2]*3,3000),3:min(counts[3]*4,1500)}\ntarget={k:v for k,v in target.items() if v>counts[k]}\nprint(\"ADASYN target:\",target)\n\nif target:\n    ada=ADASYN(sampling_strategy=target,n_neighbors=min(5,max(1,counts.min()-1)),random_state=SEED)\n    flat,ya=ada.fit_resample(flat,ytr)\n    Xtr=flat.reshape(-1,SEQ,DIM).astype(\"float32\"); ytr=ya.astype(\"int64\")\n\nprint(\"After ADASYN:\",np.bincount(ytr,minlength=C))\n\n# ---------- model ----------\nclass TemporalBiLSTM(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.inp=nn.Sequential(nn.Linear(DIM,256),nn.LayerNorm(256),nn.ReLU(),nn.Dropout(.2))\n        self.lstm=nn.LSTM(256,128,2,batch_first=True,bidirectional=True,dropout=.2)\n        self.head=nn.Sequential(nn.Linear(256,128),nn.ReLU(),nn.Dropout(.25),nn.Linear(128,C))\n    def forward(self,x):\n        x=self.inp(x); x,_=self.lstm(x); return self.head(x[:,-1])\n\nm=TemporalBiLSTM().to(D)\nopt=torch.optim.AdamW(m.parameters(),lr=2e-4,weight_decay=1e-4)\nloss_fn=nn.CrossEntropyLoss()\n\ndl=DataLoader(TensorDataset(torch.from_numpy(Xtr),torch.from_numpy(ytr)),BS,shuffle=True,pin_memory=True)\nbest=-1\n\n# ---------- full 30 epochs: NO early stopping ----------\nfor ep in range(1,EPOCHS+1):\n    m.train(); loss_sum=0\n    for xb,yb in dl:\n        xb,yb=xb.to(D,non_blocking=True),yb.to(D,non_blocking=True)\n        opt.zero_grad(set_to_none=True); loss=loss_fn(m(xb),yb); loss.backward(); opt.step()\n        loss_sum+=loss.item()*len(yb)\n\n    m.eval()\n    with torch.no_grad():\n        p=m(torch.from_numpy(Xval).to(D)).argmax(1).cpu().numpy()\n    acc=accuracy_score(yval,p); bal=balanced_accuracy_score(yval,p)\n    mf=f1_score(yval,p,average=\"macro\",zero_division=0)\n    print(f\"Epoch {ep:02d}/{EPOCHS} | Train {loss_sum/len(ytr):.4f} | Acc {acc:.4f} | BalAcc {bal:.4f} | Macro-F1 {mf:.4f}\")\n\n    if mf>best:\n        best=mf\n        torch.save({\"stage\":30,\"model_state_dict\":m.state_dict(),\"best_val_macro_f1\":best,\n                    \"sequence_length\":SEQ,\"feature_dim\":DIM},OUT/\"best_adasyn_temporal_bilstm.pth\")\n        print(\"  ✓ Best checkpoint saved\")\n\nprint(\"=\"*65)\nprint(f\"STAGE 30B COMPLETED | Best Val Macro-F1: {best:.4f}\")\nprint(f\"Checkpoint: {OUT/'best_adasyn_temporal_bilstm.pth'}\")\nprint(\"Test set: NOT USED | Early stopping: DISABLED\")\nprint(\"Stage 05B split: UNCHANGED\")\nprint(\"=\"*65)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-04T09:12:17.919292Z","iopub.execute_input":"2026-09-04T09:12:17.919573Z","iopub.status.idle":"2026-09-04T09:12:24.712235Z","shell.execute_reply.started":"2026-09-04T09:12:17.919551Z","shell.execute_reply":"2026-09-04T09:12:24.711489Z"}},"outputs":[{"name":"stdout","text":"Train windows: 1,329 | Validation: 255\nOriginal train: [961 322  29  17]\nValidation: [209   0  46   0]\nADASYN targe