==================================================\nSTAGE 32 COMPLETED | Best Val Macro-F1: 0.4271\nCheckpoint: /kaggle/working/capstone/models/stage32/best_cost_sensitive_focal_bilstm.pth\nTest set: NOT USED | Early stopping: DISABLED\nStage 05B split: UNCHANGED\n=================================================================\n","output_type":"stream"}],"execution_count":16},{"cell_type":"code","source":"# ================================================================\n# CAPSTONE — STAGE 09B | IMPROVED TRANSFER-LEARNING MODEL\n# Fixes applied vs Stage 09:\n#   1. WeightedRandomSampler (in addition to loss weighting)\n#   2. Focal Loss instead of plain weighted CrossEntropyLoss\n#   3. Early stopping on val_macro_f1 (patience-based)\n#   4. Progressive unfreezing (freeze backbone for first N epochs)\n#   5. Stronger augmentation (rotation, color jitter, crop)\n#   6. Dropout + label smoothing on the classifier head\n#   7. Per-class F1 + confusion matrix logged every epoch\n# ================================================================\nimport os, json, time\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nfrom PIL import Image\n\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch.utils.data import Dataset, DataLoader, WeightedRandomSampler\nfrom torchvision import transforms, models\nfrom sklearn.metrics import (\n    accuracy_score,\n    balanced_accuracy_score,\n    f1_score,\n    confusion_matrix,\n)\n\nBASE = Path(\"/kaggle/working/capstone\")\nDATA = BASE / \"metadata\" / \"stage07\"\nOUT = BASE / \"models\" / \"stage09b\"\nOUT.mkdir(parents=True, exist_ok=True)\n\nprint(\"=\" * 65)\nprint(\"CAPSTONE — STAGE 09B\")\nprint(\"Improved Transfer-Learning Model (imbalance + overfit fixes)\")\nprint(\"=\" * 65)\n\n# ------------------------------------------------------------\n# Configuration\n# ------------------------------------------------------------\nSEED = 42\nIMG_SIZE = 224\nBATCH_SIZE = 32\nNUM_WORKERS = 2\nMAX_EPOCHS = 30\nFREEZE_EPOCHS = 3          # keep backbone frozen for the first N epochs\nLR_HEAD = 1e-3             # LR while backbone is frozen (head only)\nLR_FINETUNE = 1e-4         # LR once backbone is unfrozen\nWEIGHT_DECAY = 1e-4\nNUM_CLASSES = 4\nDROPOUT_P = 0.4\nLABEL_SMOOTHING = 0.1\nFOCAL_GAMMA = 2.0\nEARLY_STOP_PATIENCE = 5    # epochs without val_macro_f1 improvement\n\ntorch.manual_seed(SEED)\nnp.random.seed(SEED)\nif torch.cuda.is_available():\n    torch.cuda.manual_seed_all(SEED)\n\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprint(f\"\\nDevice : {device}\")\nif torch.cuda.is_available():\n    print(f\"GPU    : {torch.cuda.get_device_name(0)}\")\n\n# ------------------------------------------------------------\n# Load manifests (Stage 07 model-ready splits — UNCHANGED)\n# ------------------------------------------------------------\ntrain = pd.read_csv(DATA / \"train_model.csv\")\nval = pd.read_csv(DATA / \"validation_model.csv\")\n\nprint(f\"\\nTrain      : {len(train):,}\")\nprint(f\"Validation : {len(val):,}\")\n\nlabels_map = {0: \"No pain\", 1: \"Low pain\", 2: \"Moderate pain\", 3: \"High pain\"}\n\n# ------------------------------------------------------------\n# Transforms — stronger augmentation on train only\n# ------------------------------------------------------------\ntrain_tf = transforms.Compose([\n    transforms.Resize((IMG_SIZE + 20, IMG_SIZE + 20)),\n    transforms.RandomCrop((IMG_SIZE, IMG_SIZE)),\n    transforms.RandomHorizontalFlip(p=0.5),\n    transforms.RandomRotation(degrees=10),\n    transforms.ColorJitter(brightness=0.2, contrast=0.2, saturation=0.1),\n    transforms.ToTensor(),\n    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),\n])\n\nval_tf = transforms.Compose([\n    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n    transforms.ToTensor(),\n    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),\n])\n\n\nclass PainDataset(Dataset):\n    def __init__(self, df, transform):\n        self.df = df.reset_index(drop=True)\n        self.transform = transform\n\n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, i):\n        r = self.df.iloc[i]\n        img = Image.open(r.image_path).convert(\"RGB\")\n        img = self.transform(img)\n        y = torch.tensor(int(r.pain_class), dtype=torch.long)\n        return img, y\n\n\ntrain_ds = PainDataset(train, train_tf)\nval_ds = PainDataset(val, val_tf)\n\n# ------------------------------------------------------------\n# WeightedRandomSampler — balances classes seen per epoch\n# ------------------------------------------------------------\nclass_counts = train.pain_class.value_counts().sort_index()\nclass_sample_weights = {\n    int(k): 1.0 / v for k, v in class_counts.items()\n}\nsample_weights = train.pain_class.map(class_sample_weights).values.astype(np.float64)\nsampler = WeightedRandomSampler(\n    weights=sample_weights,\n    num_samples=len(sample_weights),\n    replacement=True,\n)\n\ntrain_loader = DataLoader(\n    train_ds, batch_size=BATCH_SIZE, sampler=sampler,\n    num_workers=NUM_WORKERS, pin_memory=True,\n)\nval_loader = DataLoader(\n    val_ds, batch_size=BATCH_SIZE, shuffle=False,\n    num_workers=NUM_WORKERS, pin_memory=True,\n)\n\nprint(\"\\nSampler class weights (1/frequency):\")\nfor k, v in class_sample_weights.items():\n    print(f\"  {labels_map[k]:15s}: {v:.6f}\")\n\n# ------------------------------------------------------------\n# Model — ResNet18 backbone with dropout head\n# ------------------------------------------------------------\nweights = models.ResNet18_Weights.DEFAULT\nmodel = models.resnet18(weights=weights)\n\nin_features = model.fc.in_features\nmodel.fc = nn.Sequential(\n    nn.Dropout(p=DROPOUT_P),\n    nn.Linear(in_features, NUM_CLASSES),\n)\nmodel = model.to(device)\n\n\ndef set_backbone_trainable(model, trainable: bool):\n    \"\"\"Freeze/unfreeze everything except the final fc head.\"\"\"\n    for name, param in model.named_parameters():\n        if not name.startswith(\"fc.\"):\n            param.requires_grad = trainable\n\n\n# Start frozen — only the head trains for the first FREEZE_EPOCHS\nset_backbone_trainable(model, trainable=False)\n\n# ------------------------------------------------------------\n# Focal Loss (multi-class, with per-class alpha weighting)\n# ------------------------------------------------------------\ncounts = train.pain_class.value_counts().sort_index()\nalpha = torch.tensor(\n    [len(train) / (NUM_CLASSES * counts.get(i, 0)) for i in range(NUM_CLASSES)],\n    dtype=torch.float32, device=device,\n)\nalpha = alpha / alpha.sum() * NUM_CLASSES  # normalize scale\n\nprint(\"\\nFocal loss alpha (class weights):\")\nfor i, a in enumerate(alpha):\n    print(f\"  {labels_map[i]:15s}: {a.item():.4f}\")\n\n\nclass FocalLoss(nn.Module):\n    def __init__(self, alpha, gamma=2.0, label_smoothing=0.0):\n        super().__init__()\n        self.alpha = alpha\n        self.gamma = gamma\n        self.label_smoothing = label_smoothing\n\n    def forward(self, logits, targets):\n        ce = F.cross_entropy(\n            logits, targets, reduction=\"none\",\n            label_smoothing=self.label_smoothing,\n        )\n        pt = torch.exp(-ce)\n        at = self.alpha[targets]\n        loss = at * (1 - pt) ** self.gamma * ce\n        return loss.mean()\n\n\ncriterion = FocalLoss(alpha=alpha, gamma=FOCAL_GAMMA, label_smoothing=LABEL_SMOOTHING)\n\n# ------------------------------------------------------------\n# Optimizer / scheduler — only head params trainable initially\n# ------------------------------------------------------------\ndef build_optimizer(model, lr):\n    trainable_params = [p for p in model.parameters() if p.requires_grad]\n    return torch.optim.AdamW(trainable_params, lr=lr, weight_decay=WEIGHT_DECAY)\n\n\noptimizer = build_optimizer(model, LR_HEAD)\nscheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=MAX_EPOCHS)\n\n# ------------------------------------------------------------\n# Training loop with early stopping + progressive unfreezing\n# ------------------------------------------------------------\nhistory = []\nbest_f1 = -1\nbest_epoch = -1\nepochs_without_improvement = 0\nunfrozen = False\n\nfor epoch in range(1, MAX_EPOCHS + 1):\n\n    # ---- Progressive unfreezing ----\n    if epoch == FREEZE_EPOCHS + 1 and not unfrozen:\n        print(f\"\\n>>> Unfreezing backbone at epoch {epoch} (LR -> {LR_FINETUNE})\")\n        set_backbone_trainable(model, trainable=True)\n        optimizer = build_optimizer(model, LR_FINETUNE)\n        scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(\n            optimizer, T_max=MAX_EPOCHS - FREEZE_EPOCHS\n        )\n        unfrozen = True\n\n    start = time.time()\n    model.train()\n\n    train_loss = 0\n    train_true, train_pred = [], []\n\n    for images, lbls in train_loader:\n        images = images.to(device, non_blocking=True)\n        lbls = lbls.to(device, non_blocking=True)\n\n        optimizer.zero_grad(set_to_none=True)\n        logits = model(images)\n        loss = criterion(logits, lbls)\n        loss.backward()\n        optimizer.step()\n\n        train_loss += loss.item() * images.size(0)\n        train_true.extend(lbls.detach().cpu().numpy())\n        train_pred.extend(logits.argmax(1).detach().cpu().numpy())\n\n    scheduler.step()\n\n    train_loss /= len(train_ds)\n    train_acc = accuracy_score(train_true, train_pred)\n    train_f1 = f1_score(train_true, train_pred, average=\"macro\", zero_division=0)\n\n    # ---- Validation ----\n    model.eval()\n    val_loss = 0\n    val_true, val_pred = [], []\n\n    with torch.no_grad():\n        for images, lbls in val_loader:\n            images = images.to(device, non_blocking=True)\n            lbls = lbls.to(device, non_blocking=True)\n\n            logits = model(images)\n            loss = criterion(logits, lbls)\n\n            val_loss += loss.item() * images.size(0)\n            val_true.extend(lbls.cpu().numpy())\n            val_pred.extend(logits.argmax(1).cpu().numpy())\n\n    val_loss /= len(val_ds)\n    val_acc = accuracy_score(val_true, val_pred)\n    val_bal_acc = balanced_accuracy_score(val_true, val_pred)\n    val_f1 = f1_score(val_true, val_pred, average=\"macro\", zero_division=0)\n    val_f1_per_class = f1_score(\n        val_true, val_pred, average=None, zero_division=0, labels=list(range(NUM_CLASSES))\n    )\n    cm = confusion_matrix(val_true, val_pred, labels=list(range(NUM_CLASSES)))\n\n    elapsed = time.time() - start\n\n    row = {\n        \"epoch\": epoch,\n        \"backbone_frozen\": not unfrozen,\n        \"train_loss\": train_loss,\n        \"train_accuracy\": train_acc,\n        \"train_macro_f1\": train_f1,\n        \"val_loss\": val_loss,\n        \"val_accuracy\": val_acc,\n        \"val_balanced_accuracy\": val_bal_acc,\n        \"val_macro_f1\": val_f1,\n        \"lr\": optimizer.param_groups[0][\"lr\"],\n        \"time_sec\": elapsed,\n    }\n    for i in range(NUM_CLASSES):\n        row[f\"val_f1_class_{i}_{labels_map[i].replace(' ', '_')}\"] = val_f1_per_class[i]\n    history.append(row)\n\n    print(\n        f\"Epoch {epoch:02d}/{MAX_EPOCHS} | \"\n        f\"{'FROZEN' if not unfrozen else 'FT'} | \"\n        f\"Train Loss {train_loss:.4f} | \"\n        f\"Val Loss {val_loss:.4f} | \"\n        f\"Val Acc {val_acc:.4f} | \"\n        f\"Val Bal Acc {val_bal_acc:.4f} | \"\n        f\"Val Macro-F1 {val_f1:.4f} | \"\n        f\"{elapsed:.1f}s\"\n    )\n    print(f\"  Per-class F1: \" + \", \".join(\n        f\"{labels_map[i]}={val_f1_per_class[i]:.3f}\" for i in range(NUM_CLASSES)\n    ))\n    print(f\"  Confusion matrix (rows=true, cols=pred):\\n{cm}\")\n\n    # ---- Best checkpoint + early stopping ----\n    if val_f1 > best_f1:\n        best_f1 = val_f1\n        best_epoch = epoch\n        epochs_without_improvement = 0\n\n        torch.save({\n            \"stage\": \"09b\",\n            \"epoch\": epoch,\n            \"model_state_dict\": model.state_dict(),\n            \"optimizer_state_dict\": optimizer.state_dict(),\n            \"best_val_macro_f1\": best_f1,\n            \"alpha\": alpha.detach().cpu(),\n            \"seed\": SEED,\n            \"img_size\": IMG_SIZE,\n            \"num_classes\": NUM_CLASSES,\n            \"confusion_matrix\": cm.tolist(),\n        }, OUT / \"best_resnet18_stage09b.pth\")\n\n        print(f\"  ✓ Best checkpoint saved (Macro-F1={best_f1:.4f})\")\n    else:\n        epochs_without_improvement += 1\n        print(f\"  No improvement for {epochs_without_improvement} epoch(s) \"\n              f\"(best={best_f1:.4f} @ epoch {best_epoch})\")\n\n    if epochs_without_improvement >= EARLY_STOP_PATIENCE:\n        print(f\"\\n>>> Early stopping triggered at epoch {epoch} \"\n              f\"(no improvement in {EARLY_STOP_PATIENCE} epochs)\")\n        break\n\n# ------------------------------------------------------------\n# Save history + summary\n# ------------------------------------------------------------\nhistory_df = pd.DataFrame(history)\nhistory_df.to_csv(OUT / \"training_history_stage09b.csv\", index=False)\n\nsummary = {\n    \"stage\": \"09b\",\n    \"status\": \"completed\",\n    \"model\": \"ResNet18 (dropout head, progressive unfreeze)\",\n    \"pretrained\": True,\n    \"image_size\": IMG_SIZE,\n    \"batch_size\": BATCH_SIZE,\n    \"max_epochs\": MAX_EPOCHS,\n    \"epochs_run\": len(history_df),\n    \"freeze_epochs\": FREEZE_EPOCHS,\n    \"lr_head\": LR_HEAD,\n    \"lr_finetune\": LR_FINETUNE,\n    \"loss\": f\"FocalLoss(gamma={FOCAL_GAMMA}, label_smoothing={LABEL_SMOOTHING})\",\n    \"sampler\": \"WeightedRandomSampler (inverse class frequency)\",\n    \"early_stop_patience\": EARLY_STOP_PATIENCE,\n    \"best_validation_macro_f1\": float(best_f1),\n    \"best_epoch\": int(best_epoch),\n    \"final_validation_accuracy\": float(history_df.iloc[-1].val_accuracy),\n    \"final_validation_balanced_a