 in df)\n    FC=next(c for c in [\"frame_number\",\"frame_id\",\"frame\"] if c in df)\n    LC=next(c for c in [\"pain_class\",\"label\",\"pain_label\",\"class\",\"target\"] if c in df)\n    out=[]; df=df.reset_index(drop=True)\n    for sub,g in df.groupby(SC,sort=False):\n        g=g.sort_values(FC).reset_index()\n        f=pd.to_numeric(g[FC],errors=\"coerce\").to_numpy()\n        for s in range(len(g)-SEQ+1):\n            q=f[s:s+SEQ]\n            if len(q)==SEQ and np.all(np.isfinite(q)) and np.all(np.diff(q)==1):\n                out.append((g.index.to_numpy()[s:s+SEQ],int(g.iloc[s+SEQ-1][LC])))\n    return out\n\nvw=windows(val,Xv)\nXVAL=np.stack([Xv[i] for i,y in vw]); yv=np.array([y for i,y in vw])\nprint(f\"Validation windows: {len(yv):,} | Distribution: {np.bincount(yv,minlength=4)}\")\n\n# ---------- Load TRAIN features ----------\ntrain=pd.read_csv(f\"{ROOT}/metadata/stage07/train_model.csv\")\nTF=f\"{ROOT}/models/stage11/features/train_features.pt\"\nXt=torch.load(TF,map_location=\"cpu\",weights_only=False).numpy()\ntw=windows(train,Xt)\nXTR=np.stack([Xt[i] for i,y in tw]); yt=np.array([y for i,y in tw])\nprint(\"Original train:\",np.bincount(yt,minlength=4))\n\n# ---------- SMOTE on flattened temporal windows ----------\nN=len(XTR); XF=XTR.reshape(N,-1)\ncounts=np.bincount(yt,minlength=4)\ntarget={1:min(counts[0],counts[1]*2),2:min(counts[0],counts[2]*4),3:min(counts[0],counts[3]*6)}\ntarget={k:int(v) for k,v in target.items() if v>counts[k]}\n\nprint(\"SMOTE target:\",target)\nsm=SMOTE(sampling_strategy=target,k_neighbors=min(5,max(1,min(counts[1:])-1)),random_state=42)\nXF2,y2=sm.fit_resample(XF,yt)\nXTR2=XF2.reshape(-1,SEQ,FD).astype(\"float32\")\nprint(\"After SMOTE:\",np.bincount(y2,minlength=4))\n\n# ---------- Model ----------\nclass TemporalBiLSTM(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.inp=nn.Sequential(nn.Linear(FD,256),nn.LayerNorm(256),nn.ReLU(),nn.Dropout(.2))\n        self.lstm=nn.LSTM(256,128,2,batch_first=True,bidirectional=True,dropout=.2)\n        self.head=nn.Sequential(nn.Linear(256,128),nn.ReLU(),nn.Dropout(.3),nn.Linear(128,C))\n    def forward(self,x):\n        x=self.inp(x); x,_=self.lstm(x); return self.head(x[:,-1])\n\nmodel=TemporalBiLSTM().to(D)\ntr=DataLoader(TensorDataset(torch.tensor(XTR2),torch.tensor(y2)),batch_size=128,shuffle=True,pin_memory=True)\nva=DataLoader(TensorDataset(torch.tensor(XVAL,dtype=torch.float32),torch.tensor(yv)),batch_size=256)\n\n# Focal loss\ndef focal(logits,y,gamma=2):\n    ce=nn.functional.cross_entropy(logits,y,reduction=\"none\")\n    return (((1-torch.exp(-ce))**gamma)*ce).mean()\n\nopt=torch.optim.AdamW(model.parameters(),lr=1e-3,weight_decay=1e-4)\nbest=-1\n\n# ---------- FULL 30 EPOCHS: NO EARLY STOPPING ----------\nfor ep in range(1,31):\n    model.train(); loss_sum=0\n    for xb,yb in tr:\n        xb,yb=xb.to(D,non_blocking=True),yb.to(D,non_blocking=True)\n        opt.zero_grad(set_to_none=True); loss=focal(model(xb),yb); loss.backward(); opt.step()\n        loss_sum+=loss.item()*len(yb)\n    model.eval(); yp=[]\n    with torch.no_grad():\n        for xb,_ in va: yp.append(model(xb.to(D)).argmax(1).cpu().numpy())\n    yp=np.concatenate(yp)\n    mf=f1_score(yv,yp,average=\"macro\",zero_division=0)\n    ba=balanced_accuracy_score(yv,yp); ac=accuracy_score(yv,yp)\n    print(f\"Epoch {ep:02d}/30 | Train {loss_sum/len(y2):.4f} | Acc {ac:.4f} | BalAcc {ba:.4f} | Macro-F1 {mf:.4f}\")\n    if mf>best:\n        best=mf; torch.save({\"model_state_dict\":model.state_dict(),\"epoch\":ep,\"val_macro_f1\":best},f\"{OUT}/best_smote_temporal_bilstm.pth\")\n        print(\"  ✓ Best checkpoint saved\")\n\nprint(\"=\"*65)\nprint(f\"STAGE 30A COMPLETED | Best Val Macro-F1: {best:.4f}\")\nprint(f\"Checkpoint: {OUT}/best_smote_temporal_bilstm.pth\")\nprint(\"Test set: NOT USED | Early stopping: DISABLED\")\nprint(\"Stage 05B split: UNCHANGED\")\nprint(\"=\"*65)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09