\n","CONFIG_PATH = Path(\n","    \"/kaggle/working/capstone/config.json\"\n",")\n","\n","if not CONFIG_PATH.exists():\n","    raise FileNotFoundError(\n","        \"config.json not found. Please run Stage 00.\"\n","    )\n","\n","with open(\n","    CONFIG_PATH,\n","    \"r\",\n","    encoding=\"utf-8\"\n",") as f:\n","    CONFIG = json.load(f)\n","\n","\n","# ------------------------------------------------------------\n","# 3. Locate metadata\n","# ------------------------------------------------------------\n","\n","METADATA_PATH = Path(\n","    CONFIG.get(\n","        \"canonical_metadata\",\n","        \"/kaggle/working/capstone/metadata/canonical_metadata.csv\"\n","    )\n",")\n","\n","if not METADATA_PATH.exists():\n","    raise FileNotFoundError(\n","        f\"Canonical metadata not found:\\n{METADATA_PATH}\\n\"\n","        \"Please run Stage 04 first.\"\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 4. Load metadata\n","# ------------------------------------------------------------\n","\n","metadata_df = pd.read_csv(METADATA_PATH)\n","\n","print(\"=\" * 70)\n","print(\"CAPSTONE — STAGE 05\")\n","print(\"Subject-Wise Train / Validation / Test Split\")\n","print(\"=\" * 70)\n","\n","print(\n","    f\"\\nLoaded metadata: \"\n","    f\"{len(metadata_df):,} frames\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 5. Validate required columns\n","# ------------------------------------------------------------\n","\n","required_columns = [\n","    \"frame_id\",\n","    \"subject_group\",\n","    \"sequence_id\",\n","    \"frame_number\",\n","    \"image_path\",\n","    \"pspi\",\n","]\n","\n","missing_columns = [\n","    col\n","    for col in required_columns\n","    if col not in metadata_df.columns\n","]\n","\n","if missing_columns:\n","    raise ValueError(\n","        f\"Missing required columns: {missing_columns}\"\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 6. Basic subject validation\n","# ------------------------------------------------------------\n","\n","subjects = sorted(\n","    metadata_df[\"subject_group\"]\n","    .dropna()\n","    .unique()\n",")\n","\n","num_subjects = len(subjects)\n","\n","print(\n","    f\"Unique subject groups: \"\n","    f\"{num_subjects}\"\n",")\n","\n","if num_subjects < 3:\n","    raise ValueError(\n","        \"Not enough subject groups for train/validation/test splitting.\"\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 7. Check whether previous split exists\n","# ------------------------------------------------------------\n","\n","TRAIN_PATH = (\n","    Path(\"/kaggle/working/capstone/splits\")\n","    / \"train.csv\"\n",")\n","\n","VAL_PATH = (\n","    Path(\"/kaggle/working/capstone/splits\")\n","    / \"val.csv\"\n",")\n","\n","TEST_PATH = (\n","    Path(\"/kaggle/working/capstone/splits\")\n","    / \"test.csv\"\n",")\n","\n","SPLIT_SUMMARY_PATH = (\n","    Path(\"/kaggle/working/capstone/splits\")\n","    / \"split_summary.json\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 8. Reuse existing split if all artifacts exist\n","# ------------------------------------------------------------\n","\n","if (\n","    TRAIN_PATH.exists()\n","    and VAL_PATH.exists()\n","    and TEST_PATH.exists()\n","    and SPLIT_SUMMARY_PATH.exists()\n","):\n","\n","    print(\"\\nExisting split artifacts found.\")\n","    print(\"Loading previous deterministic split.\")\n","\n","    train_df = pd.read_csv(TRAIN_PATH)\n","    val_df = pd.read_csv(VAL_PATH)\n","    test_df = pd.read_csv(TEST_PATH)\n","\n","    with open(\n","        SPLIT_SUMMARY_PATH,\n","        \"r\",\n","        encoding=\"utf-8\"\n","    ) as f:\n","        split_summary = json.load(f)\n","\n","\n","else:\n","\n","    print(\"\\nCreating new subject-wise split...\")\n","\n","    # --------------------------------------------------------\n","    # Shuffle subjects deterministically\n","    # --------------------------------------------------------\n","\n","    shuffled_subjects = subjects.copy()\n","\n","    rng = np.random.default_rng(SEED)\n","    rng.shuffle(shuffled_subjects)\n","\n","    # --------------------------------------------------------\n","    # Determine subject counts\n","    # --------------------------------------------------------\n","\n","    n_train = round(num_subjects * 0.70)\n","    n_val = round(num_subjects * 0.15)\n","\n","    # Ensure at least one subject remains for test.\n","    n_train = min(\n","        n_train,\n","        num_subjects - 2\n","    )\n","\n","    n_val = min(\n","        n_val,\n","        num_subjects - n_train - 1\n","    )\n","\n","    n_test = (\n","        num_subjects\n","        - n_train\n","        - n_val\n","    )\n","\n","    # --------------------------------------------------------\n","    # Assign subjects\n","    # --------------------------------------------------------\n","\n","    train_subjects = sorted(\n","        shuffled_subjects[:n_train]\n","    )\n","\n","    val_subjects = sorted(\n","        shuffled_subjects[\n","            n_train:n_train + n_val\n","        ]\n","    )\n","\n","    test_subjects = sorted(\n","        shuffled_subjects[\n","            n_train + n_val:\n","        ]\n","    )\n","\n","    # --------------------------------------------------------\n","    # Create masks\n","    # --------------------------------------------------------\n","\n","    train_mask = metadata_df[\n","        \"subject_group\"\n","    ].isin(train_subjects)\n","\n","    val_mask = metadata_df[\n","        \"subject_group\"\n","    ].isin(val_subjects)\n","\n","    test_mask = metadata_df[\n","        \"subject_group\"\n","    ].isin(test_subjects)\n","\n","    train_df = metadata_df[\n","        train_mask\n","    ].copy()\n","\n","    val_df = metadata_df[\n","        val_mask\n","    ].copy()\n","\n","    test_df = metadata_df[\n","        test_mask\n","    ].copy()\n","\n","    # --------------------------------------------------------\n","    # Verify every frame was assigned exactly once\n","    # --------------------------------------------------------\n","\n","    total_assigned = (\n","        len(train_df)\n","        + len(val_df)\n","        + len(test_df)\n","    )\n","\n","    if total_assigned != len(metadata_df):\n","        raise RuntimeError(\n","            \"Split assignment error: \"\n","            f\"{total_assigned:,} assigned vs \"\n","            f\"{len(metadata_df):,} total.\"\n","        )\n","\n","    # --------------------------------------------------------\n","    # Verify subject disjointness\n","    # --------------------------------------------------------\n","\n","    train_set = set(train_subjects)\n","    val_set = set(val_subjects)\n","    test_set = set(test_subjects)\n","\n","    if train_set & val_set:\n","        raise RuntimeError(\n","            \"Subject leakage detected between train and validation.\"\n","        )\n","\n","    if train_set & test_set:\n","        raise RuntimeError(\n","            \"Subject leakage detected between train and test.\"\n","        )\n","\n","    if val_set & test_set:\n","        raise RuntimeError(\n","            \"Subject leakage detected between validation and test.\"\n","        )\n","\n","    # --------------------------------------------------------\n","    # Save split CSVs\n","    # --------------------------------------------------------\n","\n","    train_df.to_csv(\n","        TRAIN_PATH,\n","        index=False\n","    )\n","\n","    val_df.to_csv(\n","        VAL_PATH,\n","        index=False\n","    )\n","\n","    test_df.to_csv(\n","        TEST_PATH,\n","        index=False\n","    )\n","\n","    # --------------------------------------------------------\n","    # Build summary\n","    # --------------------------------------------------------\n","\n","    split_summary = {\n","        \"seed\": SEED,\n","        \"split_strategy\": \"subject-wise\",\n","        \"train_ratio_target\": 0.70,\n","        \"validation_ratio_target\": 0.15,\n","        \"test_ratio_target\": 0.15,\n","\n","        \"total_subjects\": num_subjects,\n","\n","        \"train_subjects\": train_subjects,\n","        \"validation_subjects\": val_subjects,\n","        \"test_subjects\": test_subjects,\n","\n","        \"num_train_subjects\": len(train_subjects),\n","        \"num_validation_subjects\": len(val_subjects),\n","        \"num_test_subjects\": len(test_subjects),\n","\n","        \"num_train_frames\": len(train_df),\n","        \"num_validation_frames\": len(val_df),\n","        \"num_test_frames\": len(test_df),\n","    }\n","\n","    with open(\n","        SPLIT_SUMMARY_PATH,\n","        \"w\",\n","        encoding=\"utf-8\"\n","    ) as f:\n","        json.dump(\n","            split_summary,\n","            f,\n","            indent=4\n","        )\n","\n","\n","# ------------------------------------------------------------\n","# 9. Print subject assignment\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"SUBJECT ASSIGNMENT\")\n","print(\"=\" * 70)\n","\n","print(\n","    f\"\\nTRAIN ({len(split_summary['train_subjects'])} subjects)\"\n",")\n","\n","print(\n","    \", \".join(\n","        split_summary[\"train_subjects\"]\n","    )\n",")\n","\n","print(\n","    f\"\\nVALIDATION \"\n","    f\"({len(split_summary['validation_subjects'])} subjects)\"\n",")\n","\n","print(\n","    \", \".join(\n","        split_summary[\"validation_subjects\"]\n","    )\n",")\n","\n","print(\n","    f\"\\nTEST ({len(split_summary['test_subjects'])} subjects)\"\n",")\n","\n","print(\n","    \", \".join(\n","        split_summary[\"test_subjects\"]\n","    )\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 10. Split statistics function\n","# ------------------------------------------------------------\n","\n","def split_statistics(df, name):\n","\n","    pspi = df[\"pspi\"]\n","\n","    print(\"\\n\" + \"-\" * 70)\n","    print(name)\n","\n","    print(f\"Frames       : {len(df):,}\")\n","    print(\n","        f\"Subjects     : \"\n","        f\"{df['subject_group'].nunique():,}\"\n","    )\n","\n","    print(\n","        f\"Sequences    : \"\n","        f\"{df['sequence_id'].nunique():,}\"\n","    )\n","\n","    print(\n","        f\"PSPI mean    : \"\n","        f\"{pspi.mean():.4f}\"\n","    )\n","\n","    print(\n","        f\"PSPI median  : \"\n","        f\"{pspi.median():.4f}\"\n","    )\n","\n","    print(\n","        f\"PSPI max     : \"\n","        f\"{pspi.max():.1f}\"\n","    )\n","\n","    print(\n","        f\"PSPI > 0     : \"\n","        f\"{(pspi > 0).sum():,} \"\n","        f\"({(pspi > 0).mean() * 100:.2f}%)\"\n","    )\n","\n","    print(\n","        f\"PSPI >= 4    : \"\n","        f\"{(pspi >= 4).sum():,} \"\n","        f\"({(pspi >= 4).mean() * 100:.2f}%)\"\n","    )\n","\n","    print(\n","        f\"PSPI >= 8    : \"\n","        f\"{(pspi >= 8).sum():,} \"\n","        f\"({(pspi >= 8).mean() * 100:.2f}%)\"\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 11. Print statistics\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"SPLIT DISTRIBUTION\")\n","print(\"=\" * 70)\n","\n","split_statistics(\n","    train_df,\n","    \"TRAIN\"\n",")\n","\n","split_statistics(\n","    val_df,\n","    \"VALIDATION\"\n",")\n","\n","split_statistics(\n","    test_df,\n","    \"TEST\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 12. Verify frame uniqueness across splits\n","# ------------------------------------------------------------\n","\n","train_frames = set(\n","    train_df[\"frame_id\"]\n",")\n","\n","val_frames = set(\n","    val_df[\"frame_id\"]\n",")\n","\n","test_frames = set(\n","    test_df[\"frame_id\"]\n",")\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"LEAKAGE VALIDATION\")\n","print(\"=\" * 70)\n","\n","print(\n","    f\"Train ∩ Validation : \"\n","    f\"{len(train_frames & val_frames)}\"\n",")\n","\n","print(\n","    f\"Train ∩ Test       : \"\n","    f\"{len(train_frames & test_frames)}\"\n",")\n","\n","print(\n","    f\"Validation ∩ Test  : \"\n","    f\"{len(val_frames & test_frames)}\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 13. Final leakage assertion\n","# ------------------------------------------------------------\n","\n","assert not (train_frames & val_frames)\n","assert not (train_frames & test_frames)\n","assert not (val_frames & test_frames)\n","\n","assert (\n","    len(train_df)\n","    + len(val_df)\n","    + len(test_df)\n","    == len(metadata_df)\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 14. Update configuration\n","# ------------------------------------------------------------\n","\n","CONFIG[\"split_strategy\"] = \"subject-wise\"\n","CONFIG[\"train_split\"] = str(TRAIN_PATH)\n","CONFIG[\"validation_split\"] = str(VAL_PATH)\n","CONFIG[\"test_split\"] = str(TEST_PATH)\n","CONFIG[\"split_summary\"] = str(SPLIT_SUMMARY_PATH)\n","\n","with open(\n","    CONFIG_PATH,\n","    \"w\",\n","    encoding=\"utf-8\"\n",") as f:\n","    json.dump(\n","        CONFIG,\n","        f,\n","        indent=4\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 15. Final status\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"STAGE 05 COMPLETED SUCCESSFULLY\")\n","print(\"=\" * 70)\n","\n","print(f\"\\nTrain CSV:\")\n","print(TRAIN_PATH)\n","\n","print(f\"\\nValidation CSV:\")\n","print(VAL_PATH)\n","\n","print(f\"\\nTest CSV:\")\n","print(TEST_PATH)\n","\n","print(f\"\\nSplit summary:\")\n","print(SPLIT_SUMMARY_PATH)\n","\n","print(\n","    \"\\nSubject leakage checks passed.\"\n",")"]},{"cell_type":"markdown","id":"74d23af0","metadata":{"papermill":{"duration":0.004807,"end_time":"2026-08-27T10:39:13.276835+00:00","exception":false,"start_time":"2026-08-27T10:39:13.272028+00:00","status":"completed"},"tags":[]},"source":["# Stage 05 — Subject-Wise Dataset Split\n","\n","To prevent subject leakage, train, validation, and test sets are separated at the subject/group level rather than at the individual frame level.\n","\n","Target allocation:\n","\n","- 70% subject groups: training\n","- 15% subject groups: validation\n","- 15% subject groups: testing\n","\n","A deterministic random seed of 42 is used so that the split remains reproducible.\n","\n","The resulting frame-level split files are stored in:\n","\n","- `/kaggle/working/capstone/splits/train.csv`\n","- `/kaggle/working/capstone/splits/val.csv`\n","- `/kaggle/working/capstone/splits/test.csv`\n","\n","The split summary and subject assignments are stored in:\n","\n","`/kaggle/working/capstone/splits/split_summary.json`\n","\n","No subject or frame is allowed to occur in more than one partition."]},{"cell_type":"code","execution_count":7,"id":"b8f0f370","metadata":{"execution":{"iopub.execute_input":"2026-08-27T10:39:13.288161Z","iopub.status.busy":"2026-08-27T10:39:13.287874Z","iopub.status.idle":"2026-08-27T10:42:35.805358Z","shell.execute_reply":"2026-08-27T10:42:35.804325Z"},"papermill":{"duration":202.525345,"end_time":"2026-08-27T10:42:35.807063+00:00","exception":false,"start_time":"2026-08-27T10:39:13.281718+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["======================================================================\n","CAPSTONE — STAGE 05B\n","FAST DISTRIBUTION-AWARE SUBJECT-WISE SPLIT\n","======================================================================\n","\n","Loaded frames: 48,398\n","\n","Creating subject-level statistics...\n","Unique subjects: 25\n","\n","Global statistics:\n","Frames       : 48,398\n","PSPI > 0     : 8,369\n","PSPI >= 4    : 1,697\n","PSPI >= 8    : 330\n","PSPI mean    : 0.4470\n","\n","Searching subject partitions...\n","This time the search operates only on 25 subject-level records.\n","\n","Candidate partitions evaluated: 16,824,500\n","Best score: 0.695904\n","\n","======================================================================\n","SELECTED SUBJECTS\n","======================================================================\n","\n","TRAIN (18 subjects)\n","042-ll042, 047-jl047, 048-aa048, 049-bm049, 052-dr052, 059-fn059, 066-mg066, 080-bn080, 092-ch092, 096-bg096, 103-jk103, 107-hs107, 108-th108, 109-ib109, 115-jy115, 120-kz120, 121-vw121, 123-jh123\n","\n","VALIDATION (4 subjects)\n","043-jh043, 064-ak064, 101-mg101, 124-dn124\n","\n","TEST (3 subjects)\n","095-tv095, 097-gf097, 106-nm106\n","\n","======================================================================\n","FINAL SPLIT DISTRIBUTION\n","======================================================================\n","\n","----------------------------------------------------------------------\n","TRAIN\n","Frames       : 34,185\n","Subjects     : 18\n","Sequences    : 138\n","PSPI mean    : 0.4472\n","PSPI median  : 0.0000\n","PSPI max     : 15.0\n","PSPI > 0     : 5,958 (17.43%)\n","PSPI >= 4    : 1,187 (3.47%)\n","PSPI >= 8    : 251 (0.73%)\n","\n","----------------------------------------------------------------------\n","VALIDATION\n","Frames       : 7,246\n","Subjects     : 4\n","Sequences    : 31\n","PSPI mean    : 0.4522\n","PSPI median  : 0.0000\n","PSPI max     : 12.0\n","PSPI > 0     : 1,248 (17.22%)\n","PSPI >= 4    : 263 (3.63%)\n","PSPI >= 8    : 59 (0.81%)\n","\n","----------------------------------------------------------------------\n","TEST\n","Frames       : 6,967\n","Subjects     : 3\n","Sequences    : 31\n","PSPI mean    : 0.4405\n","PSPI median  : 0.0000\n","PSPI max     : 11.0\n","PSPI > 0     : 1,163 (16.69%)\n","PSPI >= 4    : 247 (3.55%)\n","PSPI >= 8    : 20 (0.29%)\n","\n","======================================================================\n","LEAKAGE VALIDATION\n","======================================================================\n","Train ∩ Validation : 0\n","Train ∩ Test       : 0\n","Validation ∩ Test  : 0\n","\n","======================================================================\n","STAGE 05B COMPLETED SUCCESSFULLY\n","======================================================================\n","\n","Distribution-aware subject-wise split has been created.\n","\n","Saved artifacts:\n","/kaggle/working/capstone/splits/train.csv\n","/kaggle/working/capstone/splits/val.csv\n","/kaggle/working/capstone/splits/test.csv\n","/kaggle/working/capstone/splits/split_summary.json\n","\n","All subject and frame leakage checks passed.\n"]}],"source":["# ============================================================\n","# CAPSTONE — STAGE 05B\n","# Fast Distribution-Aware Subject-Wise Split Selection\n","# ============================================================\n","\n","import json\n","import itertools\n","import random\n","from pathlib import Path\n","\n","import numpy as np\n","import pandas as pd\n","\n","\n","# ------------------------------------------------------------\n","# 1. Configuration\n","# ------------------------------------------------------------\n","\n","SEED = 42\n","\n","random.seed(SEED)\n","np.random.seed(SEED)\n","\n","\n","# ------------------------------------------------------------\n","# 2. Paths\n","# ------------------------------------------------------------\n","\n","CONFIG_PATH = Path(\n","    \"/kaggle/working/capstone/config.json\"\n",")\n","\n","if not CONFIG_PATH.exists():\n","    raise FileNotFoundError(\n","        \"config.json not found. Run Stage 00 first.\"\n","    )\n","\n","\n","with open(\n","    CONFIG_PATH,\n","    \"r\",\n","    encoding=\"utf-8\"\n",") as f:\n","    CONFIG = json.load(f)\n","\n","\n","METADATA_PATH = Path(\n","    CONFIG[\"canonical_metadata\"]\n",")\n","\n","if not METADATA_PATH.exists():\n","    raise FileNotFoundError(\n","        f\"Canonical metadata not found:\\n{METADATA_PATH}\"\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 3. Load metadata\n","# ------------------------------------------------------------\n","\n","print(\"=\" * 70)\n","print(\"CAPSTONE — STAGE 05B\")\n","print(\"FAST DISTRIBUTION-AWARE SUBJECT-WISE SPLIT\")\n","print(\"=\" * 70)\n","\n","df = pd.read_csv(METADATA_PATH)\n","\n","print(\n","    f\"\\nLoaded frames: {len(df):,}\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 4. Create subject-level statistics ONCE\n","# ------------------------------------------------------------\n","\n","print(\"\\nCreating subject-level statistics...\")\n","\n","subject_stats = (\n","    df.groupby(\"subject_group\")\n","    .agg(\n","        frames=(\"frame_id\", \"size\"),\n","        pspi_sum=(\"pspi\", \"sum\"),\n","        positive=(\"pspi\", lambda x: (x > 0).sum()),\n","        moderate=(\"pspi\", lambda x: (x >= 4).sum()),\n","        high=(\"pspi\", lambda x: (x >= 8).sum()),\n","    )\n","    .reset_index()\n",")\n","\n","\n","subjects = sorted(\n","    subject_stats[\"subject_group\"].tolist()\n",")\n","\n","n_subjects = len(subjects)\n","\n","print(\n","    f\"Unique subjects: {n_subjects}\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 5. Convert statistics to dictionaries\n","# ------------------------------------------------------------\n","\n","stats = {}\n","\n","for _, row in subject_stats.iterrows():\n","\n","    subject = row[\"subject_group\"]\n","\n","    stats[subject] = {\n","        \"frames\": int(row[\"frames\"]),\n","        \"pspi_sum\": float(row[\"pspi_sum\"]),\n","        \"positive\": int(row[\"positive\"]),\n","        \"moderate\": int(row[\"moderate\"]),\n","        \"high\": int(row[\"high\"]),\n","    }\n","\n","\n","# ------------------------------------------------------------\n","# 6. Global statistics\n","# ------------------------------------------------------------\n","\n","total_frames = len(df)\n","\n","global_positive = int(\n","    (df[\"pspi\"] > 0).sum()\n",")\n","\n","global_moderate = int(\n","    (df[\"pspi\"] >= 4).sum()\n",")\n","\n","global_high = int(\n","    (df[\"pspi\"] >= 8).sum()\n",")\n","\n","global_pspi_sum = float(\n","    df[\"pspi\"].sum()\n",")\n","\n","global_mean = (\n","    global_pspi_sum / total_frames\n",")\n","\n","\n","print(\"\\nGlobal statistics:\")\n","print(\n","    f\"Frames       : {total_frames:,}\"\n",")\n","print(\n","    f\"PSPI > 0     : {global_positive:,}\"\n",")\n","print(\n","    f\"PSPI >= 4    : {global_moderate:,}\"\n",")\n","print(\n","    f\"PSPI >= 8    : {global_high:,}\"\n",")\n","print(\n","    f\"PSPI mean    : {global_mean:.4f}\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 7. Desired subject counts\n","# ------------------------------------------------------------\n","\n","N_TRAIN = 18\n","N_VAL = 4\n","N_TEST = 3\n","\n","if N_TRAIN + N_VAL + N_TEST != n_subjects:\n","    raise ValueError(\n","        \"Train/validation/test subject counts do not \"\n","        \"equal total number of subjects.\"\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 8. Helper for aggregating subject statistics\n","# ------------------------------------------------------------\n","\n","def aggregate_subjects(subject_list):\n","\n","    frames = 0\n","    pspi_sum = 0.0\n","    positive = 0\n","    moderate = 0\n","    high = 0\n","\n","    for subject in subject_list:\n","\n","        s = stats[subject]\n","\n","        frames += s[\"frames\"]\n","        pspi_sum += s[\"pspi_sum\"]\n","        positive += s[\"positive\"]\n","        moderate += s[\"moderate\"]\n","        high += s[\"high\"]\n","\n","    return {\n","        \"frames\": frames,\n","        \"pspi_sum\": pspi_sum,\n","        \"positive\": positive,\n","        \"moderate\": moderate,\n","        \"high\": high,\n","    }\n","\n","\n","# ------------------------------------------------------------\n","# 9. Fast partition scoring\n","# ------------------------------------------------------------\n","\n","def score_split(\n","    train_subjects,\n","    val_subjects,\n","    test_subjects\n","):\n","\n","    train = aggregate_subjects(train_subjects)\n","    val = aggregate_subjects(val_subjects)\n","    test = aggregate_subjects(test_subjects)\n","\n","    splits = {\n","        \"train\": train,\n","        \"val\": val,\n","        \"test\": test,\n","    }\n","\n","    score = 0.0\n","\n","    # --------------------------------------------------------\n","    # Desired frame proportions\n","    # --------------------------------------------------------\n","\n","    target_ratios = {\n","        \"train\": 0.70,\n","        \"val\": 0.15,\n","        \"test\": 0.15,\n","    }\n","\n","    for name, s in splits.items():\n","\n","        actual_ratio = (\n","            s[\"frames\"] / total_frames\n","        )\n","\n","        target_ratio = target_ratios[name]\n","\n","        score += (\n","            abs(actual_ratio - target_ratio)\n","            * 10.0\n","        )\n","\n","    # --------------------------------------------------------\n","    # Distribution matching\n","    # --------------------------------------------------------\n","\n","    global_positive_rate = (\n","        global_positive / total_frames\n","    )\n","\n","    global_moderate_rate = (\n","        global_moderate / total_frames\n","    )\n","\n","    global_high_rate = (\n","        global_high / total_frames\n","    )\n","\n","    for s in splits.values():\n","\n","        positive_rate = (\n","            s[\"positive\"] / s[\"frames\"]\n","        )\n","\n","        moderate_rate = (\n","            s[\"moderate\"] / s[\"frames\"]\n","        )\n","\n","        high_rate = (\n","            s[\"high\"] / s[\"frames\"]\n","        )\n","\n","        score += (\n","            abs(\n","                positive_rate\n","                - global_positive_rate\n","            )\n","            * 20.0\n","        )\n","\n","        score += (\n","            abs(\n","                moderate_rate\n","                - global_moderate_rate\n","            )\n","            * 30.0\n","        )\n","\n","        score += (\n","            abs(\n","                high_rate\n","                - global_high_rate\n","            )\n","            * 50.0\n","        )\n","\n","    # --------------------------------------------------------\n","    # Mean PSPI matching\n","    # --------------------------------------------------------\n","\n","    for s in splits.values():\n","\n","        split_mean = (\n","            s[\"pspi_sum\"]\n","            / s[\"frames\"]\n","        )\n","\n","        score += (\n","            abs(split_mean - global_mean)\n","            * 5.0\n","        )\n","\n","    # --------------------------------------------------------\n","    # Strong penalties for zero high-pain examples\n","    # --------------------------------------------------------\n","\n","    if test[\"high\"] == 0:\n","        score += 100.0\n","\n","    if val[\"high\"] == 0:\n","        score += 50.0\n","\n","    return score\n","\n","\n","# ------------------------------------------------------------\n","# 10. Search partitions\n","# ------------------------------------------------------------\n","\n","print(\n","    \"\\nSearching subject partitions...\"\n",")\n","\n","print(\n","    \"This time the search operates only on \"\n","    \"25 subject-level records.\"\n",")\n","\n","\n","best_score = float(\"inf\")\n","best_partition = None\n","\n","candidate_count = 0\n","\n","\n","# ------------------------------------------------------------\n","# 11. Enumerate test + validation subjects\n","# ------------------------------------------------------------\n","\n","for test_tuple in itertools.combinations(\n","    subjects,\n","    N_TEST\n","):\n","\n","    test_set = set(test_tuple)\n","\n","    remaining = [\n","        s\n","        for s in subjects\n","        if s not in test_set\n","    ]\n","\n","    for val_tuple in itertools.combinations(\n","        remaining,\n","        N_VAL\n","    ):\n","\n","        val_set = set(val_tuple)\n","\n","        train_set = (\n","            set(remaining)\n","            - val_set\n","        )\n","\n","        train_tuple = tuple(\n","            sorted(train_set)\n","        )\n","\n","        val_tuple_sorted = tuple(\n","            sorted(val_set)\n","        )\n","\n","        test_tuple_sorted = tuple(\n","            sorted(test_set)\n","        )\n","\n","        score = score_split(\n","            train_tuple,\n","            val_tuple_sorted,\n","            test_tuple_sorted\n","        )\n","\n","        candidate_count += 1\n","\n","        if score < best_score:\n","\n","            best_score = score\n","\n","            best_partition = {\n","                \"train\": list(train_tuple),\n","                \"val\": list(val_tuple_sorted),\n","                \"test\": list(test_tuple_sorted),\n","            }\n","\n","\n","print(\n","    f\"\\nCandidate partitions evaluated: \"\n","    f\"{candidate_count:,}\"\n",")\n","\n","print(\n","    f\"Best score: {best_score:.6f}\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 12. Extract final subjects\n","# ------------------------------------------------------------\n","\n","train_subjects = best_partition[\"train\"]\n","val_subjects = best_partition[\"val\"]\n","test_subjects = best_partition[\"test\"]\n","\n","\n","# ------------------------------------------------------------\n","# 13. Build final DataFrames\n","# ------------------------------------------------------------\n","\n","train_df = df[\n","    df[\"subject_group\"].isin(train_subjects)\n","].copy()\n","\n","val_df = df[\n","    df[\"subject_group\"].isin(val_subjects)\n","].copy()\n","\n","test_df = df[\n","    df[\"subject_group\"].isin(test_subjects)\n","].copy()\n","\n","\n","# ------------------------------------------------------------\n","# 14. Leakage checks\n","# ------------------------------------------------------------\n","\n","train_subject_set = set(train_subjects)\n","val_subject_set = set(val_subjects)\n","test_subject_set = set(test_subjects)\n","\n","assert not (\n","    train_subject_set\n","    & val_subject_set\n",")\n","\n","assert not (\n","    train_subject_set\n","    & test_subject_set\n",")\n","\n","assert not (\n","    val_subject_set\n","    & test_subject_set\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 15. Frame assignment check\n","# ------------------------------------------------------------\n","\n","assert (\n","    len(train_df)\n","    + len(val_df)\n","    + len(test_df)\n","    == len(df)\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 16. Statistics printer\n","# ------------------------------------------------------------\n","\n","def print_split_statistics(\n","    name,\n","    split_df\n","):\n","\n","    frames = len(split_df)\n","\n","    positive = int(\n","        (split_df[\"pspi\"] > 0).sum()\n","    )\n","\n","    moderate = int(\n","        (split_df[\"pspi\"] >= 4).sum()\n","    )\n","\n","    high = int(\n","        (split_df[\"pspi\"] >= 8).sum()\n","    )\n","\n","    print(\"\\n\" + \"-\" * 70)\n","    print(name)\n","\n","    print(\n","        f\"Frames       : {frames:,}\"\n","    )\n","\n","    print(\n","        f\"Subjects     : \"\n","        f\"{split_df['subject_group'].nunique():,}\"\n","    )\n","\n","    print(\n","        f\"Sequences    : \"\n","        f\"{split_df['sequence_id'].nunique():,}\"\n","    )\n","\n","    print(\n","        f\"PSPI mean    : \"\n","        f\"{split_df['pspi'].mean():.4f}\"\n","    )\n","\n","    print(\n","        f\"PSPI median  : \"\n","        f\"{split_df['pspi'].median():.4f}\"\n","    )\n","\n","    print(\n","        f\"PSPI max     : \"\n","        f\"{split_df['pspi'].max():.1f}\"\n","    )\n","\n","    print(\n","        f\"PSPI > 0     : \"\n","        f\"{positive:,} \"\n","        f\"({positive / frames * 100:.2f}%)\"\n","    )\n","\n","    print(\n","        f\"PSPI >= 4    : \"\n","        f\"{moderate:,} \"\n","        f\"({moderate / frames * 100:.2f}%)\"\n","    )\n","\n","    print(\n","        f\"PSPI >= 8    : \"\n","        f\"{high:,} \"\n","        f\"({high / frames * 100:.2f}%)\"\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 17. Print selected subjects\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"SELECTED SUBJECTS\")\n","print(\"=\" * 70)\n","\n","print(\n","    f\"\\nTRAIN ({len(train_subjects)} subjects)\"\n",")\n","\n","print(\n","    \", \".join(train_subjects)\n",")\n","\n","print(\n","    f\"\\nVALIDATION ({len(val_subjects)} subjects)\"\n",")\n","\n","print(\n","    \", \".join(val_subjects)\n",")\n","\n","print(\n","    f\"\\nTEST ({len(test_subjects)} subjects)\"\n",")\n","\n","print(\n","    \", \".join(test_subjects)\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 18. Print statistics\n","# ------------------------------------------------------------\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"FINAL SPLIT DISTRIBUTION\")\n","print(\"=\" * 70)\n","\n","print_split_statistics(\n","    \"TRAIN\",\n","    train_df\n",")\n","\n","print_split_statistics(\n","    \"VALIDATION\",\n","    val_df\n",")\n","\n","print_split_statistics(\n","    \"TEST\",\n","    test_df\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 19. Frame leakage checks\n","# ------------------------------------------------------------\n","\n","train_frames = set(\n","    train_df[\"frame_id\"]\n",")\n","\n","val_frames = set(\n","    val_df[\"frame_id\"]\n",")\n","\n","test_frames = set(\n","    test_df[\"frame_id\"]\n",")\n","\n","train_val_overlap = len(\n","    train_frames & val_frames\n",")\n","\n","train_test_overlap = len(\n","    train_frames & test_frames\n",")\n","\n","val_test_overlap = len(\n","    val_frames & test_frames\n",")\n","\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"LEAKAGE VALIDATION\")\n","print(\"=\" * 70)\n","\n","print(\n","    f\"Train ∩ Validation : \"\n","    f\"{train_val_overlap}\"\n",")\n","\n","print(\n","    f\"Train ∩ Test       : \"\n","    f\"{train_test_overlap}\"\n",")\n","\n","print(\n","    f\"Validation ∩ Test  : \"\n","    f\"{val_test_overlap}\"\n",")\n","\n","\n","assert train_val_overlap == 0\n","assert train_test_overlap == 0\n","assert val_test_overlap == 0\n","\n","\n","# ------------------------------------------------------------\n","# 20. Save final split files\n","# ------------------------------------------------------------\n","\n","SPLIT_DIR = Path(\n","    \"/kaggle/working/capstone/splits\"\n",")\n","\n","SPLIT_DIR.mkdir(\n","    parents=True,\n","    exist_ok=True\n",")\n","\n","\n","TRAIN_PATH = SPLIT_DIR / \"train.csv\"\n","VAL_PATH = SPLIT_DIR / \"val.csv\"\n","TEST_PATH = SPLIT_DIR / \"test.csv\"\n","\n","train_df.to_csv(\n","    TRAIN_PATH,\n","    index=False\n",")\n","\n","val_df.to_csv(\n","    VAL_PATH,\n","    index=False\n",")\n","\n","test_df.to_csv(\n","    TEST_PATH,\n","    index=False\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 21. Save summary\n","# ------------------------------------------------------------\n","\n","summary = {\n","    \"seed\": SEED,\n","\n","    \"strategy\":\n","        \"fast distribution-aware \"\n","        \"subject-wise exhaustive search\",\n","\n","    \"t