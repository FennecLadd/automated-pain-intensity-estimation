e split.\n\n- Focal loss\n- Moderate minority oversampling\n- Feature-space temporal augmentation\n- Full 30 epochs\n- NO early stopping\n- Validation used for model selection\n- Test set NOT USED\n=================================================================","metadata":{}},{"cell_type":"code","source":"import os,json,random,time\nfrom pathlib import Path\nimport numpy as np,pandas as pd,torch\nimport torch.nn as nn\nfrom torch.utils.data import Dataset,DataLoader,WeightedRandomSampler\nfrom sklearn.metrics import accuracy_score,balanced_accuracy_score,f1_score\n\nSEED=42; random.seed(SEED); np.random.seed(SEED); torch.manual_seed(SEED)\nif torch.cuda.is_available(): torch.cuda.manual_seed_all(SEED)\nROOT=Path(\"/kaggle/working/capstone\"); F=ROOT/\"models\"; OUT=F/\"stage31\"; OUT.mkdir(parents=True,exist_ok=True)\nD=torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\"); SEQ=16; FEAT=1280; EPOCHS=30; BATCH=64\n\ntr=pd.read_csv(ROOT/\"metadata/stage07/train_model.csv\"); va=pd.read_csv(ROOT/\"metadata/stage07/validation_model.csv\")\ndef col(df,names):\n    for n in names:\n        if n in df.columns:return n\n    raise ValueError(f\"Missing column: {names} | Available: {list(df.columns)}\")\nSC,FC,LC=col(tr,[\"subject_group\",\"subject_id\",\"subject\",\"patient_id\"]),col(tr,[\"frame_number\",\"frame_id\",\"frame\"]),col(tr,[\"pain_class\",\"label\",\"pain_label\",\"class\",\"target\"])\nVSC,VFC,VLC=col(va,[\"subject_group\",\"subject_id\",\"subject\",\"patient_id\"]),col(va,[\"frame_number\",\"frame_id\",\"frame\"]),col(va,[\"pain_class\",\"label\",\"pain_label\",\"class\",\"target\"])\n\ndef lf(paths):\n    for p in paths:\n        if p.exists():\n            x=np.load(p) if p.suffix==\".npy\" else torch.load(p,map_location=\"cpu\")\n            return x.numpy().astype(np.float32) if isinstance(x,torch.Tensor) else np.asarray(x,dtype=np.float32)\n    raise FileNotFoundError(paths)\n\nXtr=lf([F/\"stage11/features/train_features.pt\",F/\"stage11/features/train_features.npy\"])\nXva=lf([F/\"stage11/features/validation_features.pt\",F/\"stage11/features/validation_features.npy\"])\n\ndef windows(df,X,sc,fc,lc):\n    out=[]\n    for _,g in df.groupby(sc,sort=False):\n        g=g.sort_values(fc).reset_index()\n        idx=g[\"index\"].to_numpy(); y=pd.to_numeric(g[lc],errors=\"coerce\").to_numpy()\n        for s in range(len(idx)-SEQ+1):\n            ii=idx[s:s+SEQ]; yy=y[s:s+SEQ]\n            if np.isnan(yy).any():continue\n            out.append((ii,int(np.bincount(yy.astype(int),minlength=4).argmax())))\n    return np.stack([X[i] for i,_ in out]),np.array([y for _,y in out],dtype=np.int64)\n\nX,y=windows(tr,Xtr,SC,FC,LC); Xv,yv=windows(va,Xva,VSC,VFC,VLC)\nprint(\"Train windows:\",len(y),\"| Validation:\",len(yv))\nprint(\"Original train:\",np.bincount(y,minlength=4)); print(\"Validation:\",np.bincount(yv,minlength=4))\n\n# Moderate augmentation: 2x class1, 4x class2, 4x class3\nrng=np.random.default_rng(SEED); targets={1:min((y==1).sum()*2,9000),2:min((y==2).sum()*4,3500),3:min((y==3).sum()*4,1200)}\nXX=[X]; yy=[y]\nfor c,t in targets.items():\n    ids=np.where(y==c)[0]; need=max(0,t-len(ids))\n    if need:\n        z=X[rng.choice(ids,need,replace=True)].copy()\n        z+=rng.normal(0,.015*(np.std(z,axis=(0,1),keepdims=True)+1e-6),z.shape).astype(np.float32)\n        XX.append(z); yy.append(np.full(need,c,dtype=np.int64))\nX, y=np.concatenate(XX),np.concatenate(yy)\nprint(\"Augmented train:\",np.bincount(y,minlength=4))\n\nclass DS(Dataset):\n    def __init__(self,X,y):self.X=torch.tensor(X);self.y=torch.tensor(y)\n    def __len__(self):return len(self.y)\n    def __getitem__(self,i):return self.X[i],self.y[i]\n\ncnt=np.bincount(y,minlength=4); sw=(1/np.sqrt(np.maximum(cnt,1)))[y]\nsampler=WeightedRandomSampler(torch.tensor(sw,dtype=torch.double),len(y),replacement=True)\ntl=DataLoader(DS(X,y),BATCH,sampler=sampler,num_workers=2,pin_memory=True)\nvl=DataLoader(DS(Xv,yv),BATCH,shuffle=False,num_workers=2,pin_