f\"  {name}: {bi}/{len(loader)} batches\")\n    z=torch.cat(out)\n    path=FEAT/f\"{name}_features.pt\"\n    torch.save(z,path)\n    print(f\"✓ {name} features saved: {tuple(z.shape)}\")\n    return z\n\nprint(\"\\nCaching fine-tuned EfficientNet features...\")\ntrain_feat=extract(train,\"train\")\nval_feat=extract(val,\"validation\")\n\n# ---------------- TEMPORAL WINDOWS ----------------\ndef make_windows(df,features):\n    df=df.reset_index(drop=True)\n    out=[]\n    for (sub,seq),g in df.groupby([\"subject_group\",\"sequence\"],sort=False):\n        idx=g.index.to_numpy()\n        fr=g.frame_number.to_numpy()\n        for s in range(0,len(g)-SEQ_LEN+1,STRIDE):\n            if np.array_equal(fr[s:s+SEQ_LEN],\n                              np.arange(fr[s],fr[s]+SEQ_LEN)):\n                out.append((features[idx[s:s+SEQ_LEN]],\n                            int(g.iloc[s+SEQ_LEN-1].label)))\n    return out\n\ntw=make_windows(train,train_feat)\nvw=make_windows(val,val_feat)\n\nprint(f\"\\nTrain windows : {len(tw):,} | Validation : {len(vw):,}\")\nprint(\"Train distribution:\",\n      np.bincount([y for _,y in tw],minlength=4).tolist())\nprint(\"Validation distribution:\",\n      np.bincount([y for _,y in vw],minlength=4).tolist())\n\nclass WinDS(Dataset):\n    def __init__(self,w): self.w=w\n    def __len__(self): return len(self.w)\n    def __getitem__(self,i): return self.w[i]\n\ntl=DataLoader(WinDS(tw),batch_size=256,shuffle=True,\n              num_workers=0,pin_memory=True)\nvl=DataLoader(WinDS(vw),batch_size=256,shuffle=False,\n              num_workers=0,pin_memory=True)\n\nwc=np.bincount([y for _,y in tw],minlength=4).astype(float)\ntwgt=1/np.sqrt(wc)\ntwgt=twgt/twgt.mean()\ntwgt=torch.tensor(twgt,dtype=torch.float32,device=device)\n\nprint(\"Temporal weights:\",[round(x,4) for x in twgt.cpu().tolist()])\n\n# ---------------- TEMPORAL BiLSTM ----------------\nclass TemporalBiLSTM(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.